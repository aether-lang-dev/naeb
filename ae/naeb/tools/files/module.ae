// tools.files: read, edit and write (upstream src/tools/files.zig). What a
// call may touch comes in its *Ctx: the Session's observed versions, the lock
// directory, the cancel flag, the writable roots (null: sandbox off), the
// credential paths, and where a change is reported. No module state.

import std.fs
import std.string
import std.strbuilder
import std.list
import std.sync
import std.io
import naeb.jsonx
import naeb.fserr
import naeb.tools.atomic_file
import naeb.tools.file_state
import naeb.tools.rules
import naeb.tools.undo

exports(Ctx, new_ctx, read, edit, write, FILE_LIMIT, count_occurrences, replace_all)

const FILE_LIMIT = 16 * 1024 * 1024

struct Ctx {
    naeb_home: string
    cancel: ptr        // std.sync cell, or null
    state: ptr         // *file_state.State
    roots: ptr         // canonical writable roots, or null when the sandbox is off
    creds: ptr         // canonical credential paths
    reads: ptr         // a project fence's read rules (tools.rules), or null
    wdeny: ptr         // a fence's read-only paths inside the roots, or null
    // |path: string, has_before: int, before: string, after: string, tracked: int|
    // called after a successful edit/write (tracked 0: the before was unreadable)
    on_change: fn
    has_on_change: int
    undo: ptr          // *undo.Active of the running Turn, or null (undo off)
}

new_ctx(naeb_home: string, cancel: @keep ptr, state: @keep ptr, roots: @keep ptr, creds: @keep ptr) -> ptr {
    c = heap.new(Ctx)
    c.naeb_home = naeb_home
    c.cancel = cancel
    c.state = state
    c.roots = roots
    c.creds = creds
    c.reads = null
    c.wdeny = null
    c.has_on_change = 0
    c.undo = null
    return c as ptr
}

canceled_(c: *Ctx) -> int {
    if c.cancel == null { return 0 }
    if sync.atomic_load(c.cancel) != 0 { return 1 }
    return 0
}

credential_(c: *Ctx, path: string, fold: int) -> int {
    if c.creds == null { return 0 }
    n = list.list_size(c.creds)
    i = 0
    while i < n {
        p, _e = list.get_string(c.creds, i)
        if rules.same(p, path, fold) == 1 { return 1 }
        i = i + 1
    }
    return 0
}

// (canonical, "") or ("", the error the call returns as text).
resolve_(c: *Ctx, raw: string) -> (string, string) {
    path, err = atomic_file.canonical_path(raw)
    if err != "" { return "", err }
    why = read_refused_(c, path, 0)
    if why != "" { return "", why }
    return path, ""
}

// Why a read of `path` (canonical, or as a descriptor names it, on a volume
// that folds case when fold is 1) is refused, or "".
read_refused_(c: *Ctx, path: string, fold: int) -> string {
    if credential_(c, path, fold) == 1 { return "CredentialAccessDenied" }
    if rules.allows_in(c.reads, path, fold) == 0 { return "denied by the project fence: read ${path}" }
    return ""
}

blocked_(c: *Ctx, path: string, fold: int) -> string {
    if c.wdeny != null && rules.inside_in(c.wdeny, path, fold) == 1 { return "denied by the project fence: write ${path}" }
    if c.roots == null { return "" }
    if rules.inside_in(c.roots, path, fold) == 1 { return "" }
    return "outside the project; the sandbox only allows writes inside the project and its writable roots"
}

// Opens `path` (canonical) and decides on the file as opened, by the path
// its descriptor names: (data, "") or ("", Zig's error name or the fence's
// refusal). fenced is set to 1 when the refusal is the fence's or a
// credential's (its text is then the whole error).
read_file_(c: *Ctx, path: string) -> (string, string, int) {
    fd, real, fold, oerr = atomic_file.open_verified(path, atomic_file.WANT_FILE)
    if oerr != "" { return "", oerr, 0 }
    why = read_refused_(c, real, fold)
    if why != "" {
        atomic_file.close_fd(fd)
        return "", why, 1
    }
    data, rerr = atomic_file.read_fd(fd, FILE_LIMIT as long)
    atomic_file.close_fd(fd)
    if rerr != "" { return "", rerr, 0 }
    return data, "", 0
}

find_nl_(data: string, from: int) -> int {
    return string.index_of_from(data, "\n", from)
}

// A read's inclusive input cap: 16 MiB + 1 byte (upstream's boundary, which
// the whole-file read had as .limited(file_limit + 1)).
const READ_FILE_LIMIT = 16 * 1024 * 1024 + 1
const READ_BUFFER = 16384

// The page of `fd` from line `offset` (1-based) of at most `limit` lines,
// read through a fixed 16 KiB buffer so memory is the page, not the file
// (upstream readPage, ca62140): (text, next_offset, "") where next_offset is
// 0 at EOF, or (_, 0, error name). known_size is the file's size when it is
// regular and non-empty, else -1: a stream of unknown size is read to EOF so
// the same cap holds.
read_page_(fd: int, offset: long, limit: long, known_size: long) -> (string, long, string) {
    sb = strbuilder.new(1024)
    total = 0 as long
    line = 1 as long
    remaining = limit
    next_off = 0 as long
    while true {
        cap = READ_BUFFER
        if line >= offset && remaining == 0 && next_off == 0 { cap = 1 }
        room = (READ_FILE_LIMIT as long) + 1 - total
        if (cap as long) > room { cap = room as int }
        part, n, err = io.fd_read_n(fd, cap)
        if err != "" { return "", 0, "AccessDenied" }
        if n == 0 { break }
        total = total + (n as long)
        if total > (READ_FILE_LIMIT as long) { return "", 0, "StreamTooLong" }
        pos = 0
        while pos < n && next_off == 0 {
            if line >= offset && remaining == 0 {
                next_off = line
                break
            }
            nl = find_nl_(part, pos)
            end = n
            if nl >= 0 && nl < n { end = nl + 1 }
            if line >= offset { strbuilder.append(sb, string.substring(part, pos, end)) }
            if nl >= 0 && nl < n {
                if line >= offset { remaining = remaining - 1 }
                line = line + 1
            }
            pos = end
        }
        if next_off != 0 && known_size >= 0 && total <= known_size { break }
    }
    return strbuilder.finish(sb), next_off, ""
}

// One page of the file at `path` (canonical), opened and checked as opened:
// (text, next_offset or 0, "", 0), or ("", 0, error text, fenced) where fenced
// is 1 when the text is the fence's or a credential's refusal as a whole.
// before is the file's Stat from before the open; a size, inode or mtime
// that moved while the page was read fails as FileChangedDuringRead.
read_paged_(c: *Ctx, path: string, offset: long, limit: long, before: fs.Stat) -> (string, long, string, int) {
    fd, real, fold, oerr = atomic_file.open_verified(path, atomic_file.WANT_FILE)
    if oerr != "" { return "", 0, oerr, 0 }
    why = read_refused_(c, real, fold)
    if why != "" {
        atomic_file.close_fd(fd)
        return "", 0, why, 1
    }
    size, sk, _sm = fs.fd_size(fd)
    if sk == fs.KIND_OK && size > (READ_FILE_LIMIT as long) {
        atomic_file.close_fd(fd)
        return "", 0, "StreamTooLong", 0
    }
    known = -1 as long
    if sk == fs.KIND_OK && size > 0 { known = size }
    text, next_off, rerr = read_page_(fd, offset, limit, known)
    atomic_file.close_fd(fd)
    if rerr != "" { return "", 0, rerr, 0 }
    after, ak, _am = fs.stat(path, 1)
    if ak != fs.KIND_OK { return "", 0, fserr.errname(ak), 0 }
    if after.size > (READ_FILE_LIMIT as long) { return "", 0, "StreamTooLong", 0 }
    if after.ino != before.ino || after.size != before.size || after.mtime_ns != before.mtime_ns {
        return "", 0, "FileChangedDuringRead", 0
    }
    return text, next_off, "", 0
}

read(cp: ptr, args: string) -> (int, string) {
    c = cp as *Ctx
    a = jsonx.parse(args)
    if a == null || jsonx.kind(a, "path") != 3 { return 0, "expected { path: string, offset?: number, limit?: number }" }
    if jsonx.has(a, "offset") == 1 && jsonx.kind(a, "offset") != 2 { return 0, "expected { path: string, offset?: number, limit?: number }" }
    if jsonx.has(a, "limit") == 1 && jsonx.kind(a, "limit") != 2 { return 0, "expected { path: string, offset?: number, limit?: number }" }
    raw = jsonx.str_or(a, "path", "")
    offset = jsonx.long_or(a, "offset", 1)
    limit = jsonx.long_or(a, "limit", 2000)
    if offset < 0 || limit < 0 { return 0, "expected { path: string, offset?: number, limit?: number }" }
    path, perr = resolve_(c, raw)
    if perr != "" { return 0, perr }
    fd, lerr = file_state.lock(c.naeb_home, path, c.cancel)
    if lerr != "" { return 0, lerr }
    st, sk, _sm = fs.stat(path, 1)
    if sk != fs.KIND_OK {
        file_state.unlock(fd)
        return 0, "${raw}: ${fserr.errname(sk)}"
    }
    text, next_off, rerr, fenced = read_paged_(c, path, offset, limit, st)
    if rerr != "" {
        file_state.unlock(fd)
        if fenced == 1 { return 0, rerr }
        return 0, "${raw}: ${rerr}"
    }
    next = "null"
    if next_off != 0 { next = "${next_off}" }
    result = "{\"text\":${jsonx.quote(text)},\"next_offset\":${next}}"
    file_state.remember_stat(c.state, path, st)
    file_state.unlock(fd)
    return 1, result
}

// Non-overlapping occurrences of needle (non-empty) in hay.
count_occurrences(hay: string, needle: string) -> int {
    count = 0
    at = 0
    nn = string.length(needle)
    while true {
        i = string.index_of_from(hay, needle, at)
        if i < 0 { break }
        count = count + 1
        at = i + nn
    }
    return count
}

replace_all(hay: string, needle: string, with: string) -> string {
    b = strbuilder.new(string.length(hay) + 16)
    at = 0
    nn = string.length(needle)
    while true {
        i = string.index_of_from(hay, needle, at)
        if i < 0 { break }
        strbuilder.append(b, string.substring(hay, at, i))
        strbuilder.append(b, with)
        at = i + nn
    }
    strbuilder.append(b, string.substring(hay, at, string.length(hay)))
    return strbuilder.finish(b)
}

// The directory a write of `path` (canonical) goes through, opened (made
// first when create is 1) and checked as opened: (fd, its path, fold, "")
// or (-1, "", 0, error text).
write_dir_(c: *Ctx, raw: string, path: string, create: int) -> (int, string, int, string) {
    cp = c as ptr
    fd, dir, fold, err = atomic_file.open_dir(atomic_file.dirname(path), create, |d: string, f: int| {
        why = blocked_(cp as *Ctx, d, f)
        if why != "" { return "${raw}: ${why}" }
        return ""
    })
    return fd, dir, fold, err
}

// The leaf of a write in the opened directory `dir`, checked as the file it
// will replace: "" or the error text.
leaf_refused_(c: *Ctx, raw: string, dir: string, fold: int, leaf: string) -> string {
    target = atomic_file.join(dir, leaf)
    why = read_refused_(c, target, fold)
    if why != "" { return why }
    why = blocked_(c, target, fold)
    if why != "" { return "${raw}: ${why}" }
    return ""
}

// ASCII whitespace an edit hint ignores around a line.
trim_hint_(s: string) -> string {
    from = 0
    to = string.length(s)
    while from < to && (s[from] == 32 || s[from] == 9 || s[from] == 13) { from = from + 1 }
    while to > from && (s[to - 1] == 32 || s[to - 1] == 9 || s[to - 1] == 13) { to = to - 1 }
    return string.substring(s, from, to)
}

// The 1-based line of `data` that old_text's first non-blank line (trimmed)
// equals, else the first that contains it when it is 8 or more bytes; 0 none
// (upstream closestLine).
closest_line_(data: string, old_text: string) -> int {
    needle = ""
    olds = string.split(old_text, "\n")
    for i in 0..string.array_size(olds) {
        t = trim_hint_(string.array_get(olds, i))
        if string.length(t) > 0 {
            needle = t
            break
        }
    }
    string.string_array_free(olds)
    if string.length(needle) == 0 { return 0 }
    lines = string.split(data, "\n")
    substring_hit = 0
    found = 0
    n = string.array_size(lines)
    for j in 0..n {
        t2 = trim_hint_(string.array_get(lines, j))
        if t2 == needle {
            found = j + 1
            break
        }
        if substring_hit == 0 && string.length(needle) >= 8 && string.index_of(t2, needle) >= 0 { substring_hit = j + 1 }
    }
    string.string_array_free(lines)
    if found > 0 { return found }
    return substring_hit
}

edit(cp: ptr, args: string) -> (int, string) {
    c = cp as *Ctx
    usage = "expected { path: string, old_text: string, new_text: string, all?: boolean }"
    a = jsonx.parse(args)
    if a == null || jsonx.kind(a, "path") != 3 || jsonx.kind(a, "old_text") != 3 || jsonx.kind(a, "new_text") != 3 { return 0, usage }
    if jsonx.has(a, "all") == 1 && jsonx.kind(a, "all") != 1 { return 0, usage }
    raw = jsonx.str_or(a, "path", "")
    old_text = jsonx.str_or(a, "old_text", "")
    new_text = jsonx.str_or(a, "new_text", "")
    all = jsonx.bool_or(a, "all", 0)
    path, perr = resolve_(c, raw)
    if perr != "" { return 0, perr }
    why = blocked_(c, path, 0)
    if why != "" { return 0, "${raw}: ${why}" }
    fd, lerr = file_state.lock(c.naeb_home, path, c.cancel)
    if lerr != "" { return 0, lerr }
    if canceled_(c) == 1 {
        file_state.unlock(fd)
        return 0, "Canceled"
    }
    if string.length(old_text) == 0 {
        file_state.unlock(fd)
        return 0, "old_text is empty; use write to create a file"
    }
    data, rerr, fenced = read_file_(c, path)
    if rerr != "" {
        file_state.unlock(fd)
        if fenced == 1 { return 0, rerr }
        return 0, "${raw}: ${rerr}"
    }
    count = count_occurrences(data, old_text)
    if count == 0 {
        // Facts only: the file changed since this session saw it, and the line nearest old_text.
        changed = 0
        st, stk, _stm = fs.stat(path, 1)
        if stk == fs.KIND_OK && file_state.changed(c.state, path, st) == 1 { changed = 1 }
        closest = closest_line_(data, old_text)
        file_state.unlock(fd)
        if changed == 1 && closest > 0 { return 0, "old_text not found in ${raw}; file changed since last read/write; closest line: L${closest}" }
        if changed == 1 { return 0, "old_text not found in ${raw}; file changed since last read/write" }
        if closest > 0 { return 0, "old_text not found in ${raw}; closest line: L${closest}" }
        return 0, "old_text not found in ${raw}"
    }
    if count > 1 && all == 0 {
        file_state.unlock(fd)
        return 0, "old_text matches ${count} times in ${raw}; include more surrounding text or pass all: true"
    }
    out = replace_all(data, old_text, new_text)
    dfd, dir, fold, derr = write_dir_(c, raw, path, 0)
    if derr != "" {
        file_state.unlock(fd)
        return 0, derr
    }
    leaf = atomic_file.basename(path)
    lwhy = leaf_refused_(c, raw, dir, fold, leaf)
    if lwhy != "" {
        atomic_file.close_fd(dfd)
        file_state.unlock(fd)
        return 0, lwhy
    }
    // the file as it is now goes into the Turn's undo record before any change
    snap = undo.prepare(c.undo, c.naeb_home, path, 1, data, out)
    written, werr = atomic_file.replace_at(dfd, dir, leaf, out, 438, 0, 0)
    atomic_file.close_fd(dfd)
    if werr != "" {
        undo.release(snap)
        file_state.unlock(fd)
        return 0, "${raw}: ${werr}"
    }
    undo.commit(c.undo, c.naeb_home, snap, out)
    undo.release(snap)
    file_state.remember_stat(c.state, path, written)
    if c.has_on_change == 1 { call(c.on_change, path, 1, data, out, 1) }
    file_state.unlock(fd)
    return 1, "{\"replaced\":${count}}"
}

write(cp: ptr, args: string) -> (int, string) {
    c = cp as *Ctx
    a = jsonx.parse(args)
    if a == null || jsonx.kind(a, "path") != 3 || jsonx.kind(a, "content") != 3 { return 0, "expected { path: string, content: string }" }
    raw = jsonx.str_or(a, "path", "")
    content = jsonx.str_or(a, "content", "")
    path, perr = resolve_(c, raw)
    if perr != "" { return 0, perr }
    why = blocked_(c, path, 0)
    if why != "" { return 0, "${raw}: ${why}" }
    fd, lerr = file_state.lock(c.naeb_home, path, c.cancel)
    if lerr != "" { return 0, lerr }
    if canceled_(c) == 1 {
        file_state.unlock(fd)
        return 0, "Canceled"
    }
    current, rk, _rm = fs.stat(path, 1)
    if rk == fs.KIND_OK {
        if file_state.changed(c.state, path, current) == 1 {
            file_state.unlock(fd)
            return 0, "${raw} changed since this session last read or wrote it (by bash, a background agent, or the user); read it again before overwriting"
        }
    } else if rk != fs.KIND_NOT_FOUND {
        file_state.unlock(fd)
        return 0, "${raw}: ${fserr.errname(rk)}"
    }
    tracked = 1
    has_before = 0
    before = ""
    if rk == fs.KIND_OK {
        b, berr, bfenced = read_file_(c, path)
        if bfenced == 1 {
            file_state.unlock(fd)
            return 0, berr
        }
        if berr != "" { tracked = 0 } else {
            before = b
            has_before = 1
        }
    }
    // the file as it is now goes into the Turn's undo record before any change;
    // an unreadable original means the Turn cannot be fully undone
    snap = null
    if tracked == 0 { undo.mark_incomplete(c.undo, c.naeb_home, undo.REASON_UNAVAILABLE) } else {
        snap = undo.prepare(c.undo, c.naeb_home, path, has_before, before, content)
    }
    dfd, dir, fold, derr = write_dir_(c, raw, path, 1)
    if derr != "" {
        undo.release(snap)
        file_state.unlock(fd)
        return 0, derr
    }
    leaf = atomic_file.basename(path)
    lwhy = leaf_refused_(c, raw, dir, fold, leaf)
    if lwhy != "" {
        atomic_file.close_fd(dfd)
        undo.release(snap)
        file_state.unlock(fd)
        return 0, lwhy
    }
    written, werr = atomic_file.replace_at(dfd, dir, leaf, content, 438, 0, 0)
    atomic_file.close_fd(dfd)
    if werr != "" {
        undo.release(snap)
        file_state.unlock(fd)
        return 0, "${raw}: ${werr}"
    }
    undo.commit(c.undo, c.naeb_home, snap, content)
    undo.release(snap)
    file_state.remember_stat(c.state, path, written)
    if c.has_on_change == 1 { call(c.on_change, path, has_before, before, content, tracked) }
    file_state.unlock(fd)
    return 1, "{\"bytes\":${string.length(content)}}"
}
