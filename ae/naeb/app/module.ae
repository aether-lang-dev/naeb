// app: the whole program, upstream src/main.zig. `naeb` runs with the
// project's fence (docs/naeb/adr/0001: naeb.ae through naeb.fence.policy, else the
// default fence), plus `naeb build [-y]`; `naeb --mode unfenced ...` runs with
// no fence, as upstream does, and says so on a terminal's stderr and in the Session log. This slice has `naeb ask [--json] [-c|--resume <id>]
// [--effort <level>] <prompt|->`, `naeb js '<code>'`, `naeb login`/`logout`
// (API keys only), `--help` and `--version`, and the hidden
// `naeb __jail [-w <root>]... -- <command>...` helper the Linux write sandbox
// execs, and `naeb replay` (offline Run replay, naeb.run_replay). The TUI
// comes with the TUI slice (bare `naeb` says so); `update` is not ported.

import std.os hiding (exec, run_capture, run_pipe, run_pipe_drain_and_wait, run_socket,
    run_stdio, run_full, run_supervised, spawn_proc, spawn_proc_to, os_system,
    os_exec_raw, os_execv, os_run, os_run_capture_raw, os_run_capture_status_raw,
    os_run_pipe_raw, os_run_pipe_drain_and_wait_raw, os_run_socket_raw,
    os_run_stdio_raw, os_run_full_raw, os_run_supervised_raw, os_spawn_raw,
    os_spawn_to_raw)
import std.string
import std.list
import std.fs
import std.io
import std.sync
import std.worker
import std.signal
import naeb.jsonx
import naeb.sandbox
import naeb.tools
import naeb.tools.jail
import naeb.fence
import naeb.fence.policy
import naeb.build_info
import naeb.tools.background
import naeb.tools.agent_input
import naeb.provider.types
import naeb.config
import naeb.config.env
import naeb.auth
import naeb.session
import naeb.run_replay
import term
import term.input
import naeb.tui
import naeb.tui.live
import naeb.tui.clock

exports(run)

const HELP = "naeb · a coding agent whose unit of work is a Run\n\nUsage:\n  naeb [options]                        Open the TUI\n  naeb ask [options] <prompt|->         Ask once; - reads stdin\n  naeb js <code>                        Run sandbox JavaScript\n  naeb login [service] [--device]       Sign in or store a key; no service lists them\n  naeb update [version]                 Upgrade in place\n  naeb logout <service>                 Remove naeb's stored credential\n  naeb replay <session-id> --all [--json] Replay recorded Runs offline\n\nOptions:\n  -h, --help            Show help\n  -V, --version         Show version\n  -c, --continue        Continue this directory's latest session\n  --resume <id>         Resume a session (32 lowercase hex characters)\n  --effort <level>      Set reasoning effort; /effort lists levels\n  --json                Stream NDJSON events (ask only)\n  --mode <mode>         fenced (default) or unfenced; first argument only; unfenced runs with no\n                        project fence and is announced on a terminal's stderr and always in the Session log\n\nTUI: Enter sends · Shift+Enter adds a line · Esc cancels · Ctrl+O opens latest details · click a Run\nType / for commands, /help for keys, /status for timing and cache details.\nFirst run: naeb, then /provider to sign in; /model picks a model.\nSetup: see README.md and docs/config.md.\n"

// Bare `naeb`: the TUI (upstream tui.run) on the controlling terminal, over
// a Session with undo on; -c/--resume reopen one.
run_tui_(envp: @keep ptr, ap: ptr, fence: @keep ptr) {
    a = ap as *Args
    home, herr = config.home(envp)
    if herr != "" { fail_(0, herr, "", zero_usage_(), 0, "") }
    cfg, cerr, cdetail = config.load(envp, home)
    if cerr != "" { fail_(0, cerr, cdetail, zero_usage_(), 0, "") }
    if a.has_effort == 1 {
        eerr = types.set_effort(cfg, a.effort)
        if eerr != "" { fail_(0, eerr, "", zero_usage_(), 0, "") }
    }
    op = session.new_options(home, env.get(envp, "HOME"))
    o = op as *session.Options
    o.resume_id = a.resume_id
    o.continue_latest = a.continue_latest
    o.patches_off = env.get(envp, "NAEB_PATCHES_OFF")
    o.record = config.record_tools(envp)
    o.self_exe = self_exe_()
    o.fence = fence
    o.undo_enabled = 1
    sp, serr, sdetail = session.init(cfg, op)
    if serr != "" { fail_(0, serr, sdetail, zero_usage_(), 0, "") }
    t, terr = term.open()
    if terr != "" {
        session.close(sp)
        eprint_("naeb: ${terr}\n")
        exit(1)
    }
    term.enter_alt_screen(t)
    term.query_terminal(t, 1000)
    term.set_bracketed_paste(t, true)
    term.set_mouse_mode(t, true)
    term.query_color(t, input.REPORT_BG)
    if t.cap_color_scheme_updates { term.subscribe_color_scheme(t) }
    p = live.new(sp, cfg, op, home)
    if fence != null {
        nsrc = env.get(envp, "NAEB_SRC")
        if nsrc == "" { nsrc = build_info.source_dir() }
        live.set_naeb_src(p, nsrc)
    }
    app = tui.new(t as ptr, p as ptr, clock.of_terminal(t as ptr) as ptr, envp)
    tui.run(app)
    tui.free(app)
    term.close(t)
    session.close(live.session_of(p))
}

// --mode <fenced|unfenced> is a global option and only ever the first two
// arguments, set by the person who starts naeb: not by the environment, a
// config file, a project file, or anything a Run, a hook, a skill or a
// sub-agent can reach. The rest of the program sees the arguments without it.
mode_skip_() -> int {
    if os.args_count() >= 2 && os.args_get(1) == "--mode" { return 2 }
    return 0
}

args_n_() -> int { return os.args_count() - mode_skip_() }

arg_(i: int) -> string {
    if i == 0 { return os.args_get(0) }
    return os.args_get(i + mode_skip_())
}

// (mode, error): "fenced" (the default) or "unfenced".
mode_() -> (string, string) {
    if mode_skip_() == 0 { return "fenced", "" }
    if os.args_count() < 3 { return "", "--mode needs fenced or unfenced" }
    m = os.args_get(2)
    if m == "fenced" || m == "unfenced" { return m, "" }
    return "", "unknown mode ${m}: use --mode fenced or --mode unfenced"
}

const UNFENCED_NOTICE = "naeb: UNFENCED (--mode unfenced): no project fence confines commands, file tools or network access"

self_exe_() -> string {
    a0 = os.args_get(0)
    if string.index_of(a0, "/") >= 0 {
        real, _k, err = fs.realpath(a0)
        if err == "" { return real }
    }
    return a0
}

// This binary's canonical path, looked up on PATH when argv[0] has no
// slash; "" when not found.
own_path_(envp: ptr) -> string {
    exe = self_exe_()
    if string.index_of(exe, "/") >= 0 { return exe }
    dirs = string.split(env.get(envp, "PATH"), ":")
    found = ""
    i = 0
    while i < string.array_size(dirs) && found == "" {
        d = string.copy(string.array_get(dirs, i))
        if d != "" && fs.exists("${d}/${exe}") == 1 {
            real, _k, err = fs.realpath("${d}/${exe}")
            if err == "" { found = real }
        }
        i = i + 1
    }
    string.array_free(dirs)
    return found
}

// naeb will not run from inside a root its children may write: a child
// could replace the binary and widen the next run's fence.
naeb_outside_roots_(f: ptr, envp: ptr) {
    exe = own_path_(envp)
    if exe == "" { return }
    sp = fence.resolve(f, os.getcwd(), "", env.pairs(envp)) as *jail.Spec
    if jail.allows(sp.writes, exe) == 0 { return }
    eprint_("naeb: the naeb binary ${exe} lies inside a root the project fence lets commands write; install it outside the project (docs/naeb/adr/0001)\n")
    exit(2)
}

// The y/N of `naeb build`: true only for "y" or "yes" on stdin; EOF is no.
confirm_() -> fn {
    return |question: string| {
        io.fd_write(1, string.bytes(question))
        line, eof, err = io.fd_read_line_status(0)
        if err != "" || (eof == true && string.length(line) == 0) {
            io.fd_write(1, string.bytes("\n"))
            return 0
        }
        t = string.to_lower(string.trim(line))
        if t == "y" || t == "yes" { return 1 }
        return 0
    }
}

// `naeb build [-y]`: review and build this project's policy (naeb.fence.policy).
build_(envp: ptr) -> int {
    yes = 0
    i = 2
    while i < args_n_() {
        a = arg_(i)
        if a == "-y" || a == "--yes" {
            yes = 1
        } else {
            eprint_("naeb: usage: naeb build [-y]\n")
            return 1
        }
        i = i + 1
    }
    src = env.get(envp, "NAEB_SRC")
    if src == "" { src = build_info.source_dir() }
    return policy.build(env.get(envp, "HOME"), os.getcwd(), src, yes, confirm_())
}

read_stdin_() -> string {
    out = ""
    while true {
        chunk, count, err = io.fd_read_n(0, 65536)
        if err != "" || count == 0 { break }
        out = "${out}${chunk}"
    }
    return out
}

eprint_(text: string) { io.fd_write(2, string.bytes(text)) }

// One NDJSON line, written at once (not buffered until exit): events are live.
jline_(text: string) { io.stdout_write("${text}\n") }

// What the CLI parsed.
struct Args {
    ask: int
    json: int
    agent_input: int
    prompt: string
    has_prompt: int
    effort: string
    has_effort: int
    resume_id: string
    continue_latest: int
    err: string          // error name, "" none
    detail: string
}

parse_args_(n: int) -> ptr {
    a = heap.new(Args)
    a.ask = 0
    a.json = 0
    a.agent_input = 0
    a.prompt = ""
    a.has_prompt = 0
    a.effort = ""
    a.has_effort = 0
    a.resume_id = ""
    a.continue_latest = 0
    a.err = ""
    a.detail = ""
    i = 1
    while i < n {
        arg = arg_(i)
        if a.ask == 0 && arg == "ask" {
            a.ask = 1
        } else if a.ask == 1 && arg == "--agent-input" {
            a.agent_input = 1
        } else if a.ask == 1 && arg == "--json" {
            a.json = 1
        } else if arg == "-c" || arg == "--continue" {
            a.continue_latest = 1
        } else if arg == "--effort" {
            i = i + 1
            if i == n {
                a.err = "MissingReasoningEffort"
                return a as ptr
            }
            a.effort = arg_(i)
            a.has_effort = 1
        } else if arg == "--resume" {
            i = i + 1
            if i == n {
                a.err = "MissingSessionId"
                return a as ptr
            }
            a.resume_id = arg_(i)
        } else if string.length(arg) > 1 && string.starts_with(arg, "-") == 1 {
            a.err = "InvalidArguments"
            a.detail = "Unknown option: ${arg} · run naeb --help"
            return a as ptr
        } else if a.ask == 1 && a.has_prompt == 0 {
            a.prompt = arg
            a.has_prompt = 1
        } else {
            a.err = "InvalidArguments"
            return a as ptr
        }
        i = i + 1
    }
    if a.continue_latest == 1 && a.resume_id != "" {
        a.err = "ConflictingResumeOptions"
        return a as ptr
    }
    if a.ask == 1 && a.has_prompt == 0 { a.err = "MissingPrompt" }
    return a as ptr
}

// The failure line: {"error":{…}} in JSON mode, else "naeb: <text>" on stderr.
fail_(json: int, err: string, detail: string, usage_json: string, steps: int, timing: string) {
    text = detail
    if text == "" {
        if json == 1 && (err == "MissingPrompt" || err == "InvalidArguments") {
            text = err
        } else {
            text = session.error_message(err)
        }
    }
    if json == 1 {
        t = ""
        if timing != "" { t = ",\"timing\":${timing}" }
        jline_("{\"error\":{\"message\":${jsonx.quote(text)},\"usage\":${usage_json},\"steps\":${steps}${t}}}")
    } else {
        eprint_("naeb: ${text}\n")
    }
    exit(1)
}

// main.zig's errorMessage for the replay errors, else the Session's.
replay_error_message_(err: string) -> string {
    match err {
        "InvalidReplayArguments" -> { return "Use naeb replay <session-id> --run <step>:<run> [--script <file>] [--json], or naeb replay <session-id> --all [--json]." }
        "ReplayMetadataNotFound" -> { return "No replay recording found for this Run; recording must be enabled when the original Run executes." }
        "ReplayRunNotFound" -> { return "Run not found; step counts assistant messages across the entire session (1-based), run indexes tool_calls (0-based)." }
        _ -> { return session.error_message(err) }
    }
}

zero_usage_() -> string { return types.usage_json(types.usage_new()) }

help_(envp: ptr, fenced: int) {
    print(HELP)
    if fenced == 1 { println("naeb: fenced by the project's naeb.ae; naeb build [-y] reviews and builds it.") }
    if fenced == 0 { println("naeb: --mode unfenced: no project fence confines this run.") }
    home, herr = config.home(envp)
    if herr == "" {
        cfg, err, _d = config.load(envp, home)
        if err == "" {
            println("Active provider: ${types.name(cfg)}")
            return
        }
    }
    println("Active provider: unavailable (invalid configuration)")
}

line_reader_(secret: int) -> fn {
    return |prompt: string| {
        io.fd_write(1, string.bytes(prompt))
        masked = false
        echo_was_on = false
        if secret == 1 {
            was, merr = io.set_echo(0, false)
            echo_was_on = was
            masked = merr == "" && io.is_terminal(0)
        }
        line, eof, err = io.fd_read_line_status(0)
        if masked {
            io.set_echo(0, echo_was_on)
            io.fd_write(1, string.bytes("\n"))
        }
        if err != "" || (eof == true && string.length(line) == 0) { return auth.EOF_LINE }
        return line
    }
}

rest_args_(from: int) -> ptr {
    l = list.list_new()
    i = from
    while i < args_n_() {
        list.list_add(l, arg_(i))
        i = i + 1
    }
    return l
}

// Plain `naeb ask` output: text deltas on stdout, Runs dimmed on stderr.
print_event_(ev: string) {
    v = jsonx.parse(ev)
    if v == null { return }
    if jsonx.has(v, "delta") == 1 {
        d = jsonx.field(v, "delta")
        if jsonx.str_or(d, "kind", "") == "text" { print(jsonx.str_or(d, "text", "")) }
    } else if jsonx.has(v, "run_start") == 1 {
        eprint_("\n\x1b[33mrun ▸\x1b[0m ${jsonx.str_or(v, "run_start", "")}\n")
    } else if jsonx.has(v, "run_end") == 1 {
        r = jsonx.field(v, "run_end")
        eprint_("\x1b[2m${jsonx.str_or(r, "output", "")}\x1b[0m\n")
        changes = jsonx.field(r, "changes")
        n = jsonx.array_size(changes)
        i = 0
        while i < n {
            c = jsonx.array_at(changes, i)
            created = ""
            if jsonx.bool_or(c, "created", 0) == 1 { created = " (new)" }
            eprint_("\x1b[2mchanged ${jsonx.str_or(c, "path", "")}${created} +${jsonx.long_or(c, "added", 0 as long)} −${jsonx.long_or(c, "removed", 0 as long)}\x1b[0m\n")
            i = i + 1
        }
    } else if jsonx.has(v, "retry") == 1 {
        r2 = jsonx.field(v, "retry")
        eprint_("\x1b[2mretry ${jsonx.int_or(r2, "attempt", 0)} in ${jsonx.long_or(r2, "delay_ms", 0 as long) / 1000}s: ${jsonx.str_or(r2, "reason", "")}\x1b[0m\n")
    } else if jsonx.has(v, "notice") == 1 {
        eprint_("\x1b[2m${jsonx.str_or(v, "notice", "")}\x1b[0m\n")
    }
    jsonx.free(v)
}

jail_helper_() {
    n = os.args_count()
    if n >= 2 && os.args_get(1) == jail.HELPER_COMMAND {
        println("naeb __jail: ${jail.helper(rest_args_(2))}")
        exit(126)
    }
}

// The program: fenced by the project's policy unless the person who started
// it said --mode unfenced on the command line (upstream's behaviour, no fence).
run() {
    jail_helper_()
    mode, merr = mode_()
    if merr != "" {
        eprint_("naeb: ${merr}\n")
        exit(2)
    }
    if mode == "unfenced" {
        run_(env.from_process(), null)
        return
    }
    // A descriptor naeb inherited would reach every fenced child, past
    // Landlock and SBPL, which check opens (docs/naeb/adr/0001).
    jail.cloexec_inherited()
    if args_n_() >= 2 && arg_(1) == "build" {
        code = build_(env.from_process())
        if code != 0 { exit(code) }
        return
    }
    jail.scrub_environ()
    envp = env.from_process()
    f, notice, err = policy.start_fence(env.get(envp, "HOME"), os.getcwd(), env.pairs(envp))
    if err != "" {
        eprint_("naeb: ${err}\n")
        exit(2)
    }
    if notice != "" { eprint_("${notice}\n") }
    naeb_outside_roots_(f, envp)
    run_(envp, f)
}

// The whole program. fence: naeb's *fence.Fence, or null (--mode unfenced).
run_(envp: @keep ptr, fence: @keep ptr) {
    n = args_n_()
    i = 1
    while i < n {
        h = arg_(i)
        if h == "--help" || h == "-h" {
            fenced = 0
            if fence != null { fenced = 1 }
            help_(envp, fenced)
            return
        }
        i = i + 1
    }
    if n == 2 && (arg_(1) == "--version" || arg_(1) == "-V") {
        println("naeb ${session.VERSION}")
        return
    }
    if n >= 2 && (arg_(1) == "login" || arg_(1) == "logout") {
        lhome, lherr = config.home(envp)
        if lherr != "" {
            eprint_("naeb: ${session.error_message(lherr)}\n")
            exit(1)
        }
        code = 0
        out = ""
        errtext = ""
        if arg_(1) == "login" {
            code, out, errtext = auth.login(lhome, envp, rest_args_(2), line_reader_(0), line_reader_(1))
        } else {
            code, out, errtext = auth.logout(lhome, envp, rest_args_(2))
        }
        print(out)
        eprint_(errtext)
        if code != 0 { exit(code) }
        return
    }
    if n >= 2 && arg_(1) == "replay" {
        rhome, rherr = config.home(envp)
        if rherr != "" {
            eprint_("naeb: ${replay_error_message_(rherr)}\n")
            exit(1)
        }
        rout, rerrs, rerr = run_replay.run(rhome, rest_args_(2))
        if rerr != "" {
            eprint_("naeb: ${replay_error_message_(rerr)}\n")
            exit(1)
        }
        io.stdout_write(rout)
        eprint_(rerrs)
        return
    }
    if fence == null && io.is_terminal(2) { eprint_("${UNFENCED_NOTICE}\n") }
    if n >= 3 && arg_(1) == "js" {
        home_dir = env.get(envp, "HOME")
        if home_dir == "" { home_dir = "/" }
        t = tools.new(home_dir)
        (t as *tools.Tools).self_exe = self_exe_()
        if env.get(envp, "NAEB_SANDBOX") == "workspace" { tools.set_workspace(t, 1) }
        if fence != null { tools.set_fence(t, fence) }
        sc = tools.new_scope(t, 0)
        jo = sandbox.eval(arg_(2), sandbox.limits(), tools.host(sc), null) as *sandbox.Outcome
        background.stop_all((t as *tools.Tools).background)
        print(jo.logs)
        if jo.ok == 1 {
            if jo.text != "undefined" { println(jo.text) }
            return
        }
        println(jo.text)
        exit(1)
    }
    ap = parse_args_(n)
    a = ap as *Args
    if a.err != "" { fail_(a.json, a.err, a.detail, zero_usage_(), 0, "") }
    if a.ask == 0 {
        run_tui_(envp, ap, fence)
        return
    }
    home, herr = config.home(envp)
    if herr != "" { fail_(a.json, herr, "", zero_usage_(), 0, "") }
    cfg = null
    fork = null
    undo_dir = ""
    if a.agent_input == 1 {
        // A subagent: prompt, Config and fork come from the parent on stdin.
        ip, ierr = agent_input.parse(read_stdin_())
        if ierr != "" { fail_(a.json, ierr, "", zero_usage_(), 0, "") }
        input = ip as *agent_input.Input
        cfg = input.config
        ic = cfg as *types.Config
        if ic.api_key_env != "" { ic.api_key = env.get(envp, ic.api_key_env) }
        config.apply_store(home, cfg)
        a.prompt = input.prompt
        fork = input.fork
        undo_dir = input.undo_dir
    } else {
        lcfg, cerr, cdetail = config.load(envp, home)
        if cerr != "" { fail_(a.json, cerr, cdetail, zero_usage_(), 0, "") }
        cfg = lcfg
    }
    c = cfg as *types.Config
    if a.has_effort == 1 {
        eerr = types.set_effort(cfg, a.effort)
        if eerr != "" { fail_(a.json, eerr, "", zero_usage_(), 0, "") }
    }
    if config.credentialed(cfg) == 0 {
        if env.has(envp, "NAEB_PROVIDER") == 0 {
            fail_(a.json, "MissingApiKey", "No provider · run naeb login", zero_usage_(), 0, "")
        }
        hint = c.api_key_env
        if hint == "" { hint = "the provider key environment variable" }
        fail_(a.json, "MissingApiKey", "${types.name(cfg)}: no API key; set ${hint} or run naeb login ${types.name(cfg)}.", zero_usage_(), 0, "")
    }
    op = session.new_options(home, env.get(envp, "HOME"))
    o = op as *session.Options
    o.resume_id = a.resume_id
    o.continue_latest = a.continue_latest
    o.patches_off = env.get(envp, "NAEB_PATCHES_OFF")
    o.record = config.record_tools(envp)
    o.parent_session_id = env.get(envp, "NAEB_PARENT_SESSION_ID")
    depth_text = env.get(envp, "NAEB_AGENT_DEPTH")
    if depth_text != "" { o.depth = jsonx.long_of(depth_text) as int }
    o.self_exe = self_exe_()
    o.fence = fence
    o.fork = fork
    o.undo_dir = undo_dir
    sp, serr, sdetail = session.init(cfg, op)
    if serr != "" { fail_(a.json, serr, sdetail, zero_usage_(), 0, "") }
    s = sp as *session.Session
    prompt_text = a.prompt
    if a.agent_input == 0 && prompt_text == "-" { prompt_text = read_stdin_() }
    if a.json == 1 { jline_("{\"start\":{\"session_id\":${jsonx.quote(s.id)}}}") }
    cancel = sync.atomic_new(0)
    sig_cell = s.signal
    watch, werr = os.signal_watch([signal.SIGINT(), signal.SIGTERM()])
    if werr == "" {
        worker.run_detached(|| {
            got = 0
            while got == 0 {
                got = os.signal_received(watch)
                if got == 0 { sleep(20) }
            }
            sync.atomic_store(sig_cell, got as long)
            sync.atomic_store(cancel, 1)
            return null
        })
    }
    json = a.json
    sink = session.new_sink(null, |ctx: ptr, ev: string| {
        if json == 1 {
            jline_(ev)
        } else {
            print_event_(ev)
        }
    })
    err, detail = session.turn(sp, prompt_text, sink, cancel)
    hook_status = "completed"
    if err != "" {
        hook_status = "failed"
        if sync.atomic_load(cancel) != 0 { hook_status = "cancelled" }
    }
    session.start_turn_end_hooks(sp, hook_status, null, |c: ptr, notice: string| { }, 0)
    session.close(sp)
    if err != "" { fail_(a.json, err, detail, types.usage_json(s.usage), s.steps, session.timing_json(sp)) }
    if a.json == 1 {
        jline_("{\"end\":{\"text\":${jsonx.quote(s.final_text)},\"usage\":${types.usage_json(s.usage)},\"steps\":${s.steps},\"timing\":${session.timing_json(sp)}}}")
        return
    }
    println("")
    u = s.usage as *types.Usage
    plural = "s"
    if s.steps == 1 { plural = "" }
    eprint_("[${c.model}] turn: ${s.steps} step${plural}, in=${u.prompt_tokens} (cache hit ${u.prompt_cache_hit_tokens}) out=${u.completion_tokens}\n")
}
