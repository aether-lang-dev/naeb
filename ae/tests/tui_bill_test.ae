// Ports the three tests of upstream src/tui/bill.zig (as of cf751b3) under their names, plus a
// from_json check of naeb.tui.turn_summary (new here).
import std.spec
import naeb.tui.bill
import naeb.tui.turn_summary

example_() -> turn_summary.TurnSummary {
    return turn_summary.new("completed", 3,
        turn_summary.usage(6500, 100, 6000, 0),
        turn_summary.timing(41999, 30000, 11000, 3200000, 18000, 0, 0))
}

main() {
    fw = spec.init()
    spec.describe(fw, "tui.bill") {
        spec.it("quiet footer shows only elapsed time and status retains statistics") callback {
            ex = example_()
            spec.assert_str_eq(bill.format_footer(ex, 200), "41s", "full")
            spec.assert_str_eq(bill.format_footer(turn_summary.new("completed", 1), 200), "", "steps alone")
            d = bill.details(ex, 2)
            spec.assert_contains(d, "2 Runs · 3 steps", "runs and steps")
            spec.assert_contains(d, "model 30s · Run 11s", "model")
            spec.assert_contains(d, "Cache 6000 tokens · 92% of input", "cache")
            spec.assert_str_eq(d, "Last turn · completed\n2 Runs · 3 steps\nTotal 41s · model 30s · Run 11s\nInput 6500 tokens · output 100 tokens\nCache 6000 tokens · 92% of input · writes 0 tokens\nTool data 3.2MB → 18kB\nDelegation · llm 0 · agent 0", "details")
        }
        spec.it("zero time and unrelated statistics do not create a footer") callback {
            spec.assert_str_eq(bill.format_footer(turn_summary.new(), 200), "", "zero")
            spec.assert_str_eq(bill.format_footer(turn_summary.new("completed", 0, turn_summary.usage(), turn_summary.timing(0, 0, 0, 320, 18000)), 200), "", "bytes only")
            spec.assert_str_eq(bill.format_footer(turn_summary.new("canceled", 0, turn_summary.usage(), turn_summary.timing(1000)), 200), "1s", "canceled")
            spec.assert_str_eq(bill.format_footer(turn_summary.new("failed", 0, turn_summary.usage(), turn_summary.timing(1000)), 200), "1s", "failed")
        }
        spec.it("footer omits a duration that cannot fit") callback {
            spec.assert_str_eq(bill.format_footer(example_(), 2), "", "2")
            spec.assert_str_eq(bill.format_footer(example_(), 3), "41s", "3")
        }
        spec.it("turn_summary.from_json reads the shape, missing fields are 0") callback {
            s = turn_summary.from_json("{\"status\":\"failed\",\"steps\":2,\"usage\":{\"prompt_tokens\":10,\"completion_tokens\":5,\"prompt_cache_hit_tokens\":4,\"prompt_cache_write_tokens\":3},\"timing\":{\"wall_ms\":1500,\"llm_calls\":7}}")
            spec.assert_str_eq(s.status, "failed", "status")
            spec.assert_eq_long(s.steps, 2, "steps")
            spec.assert_eq_long(s.usage.prompt_cache_write_tokens, 3, "write")
            spec.assert_eq_long(s.timing.wall_ms, 1500, "wall")
            spec.assert_eq_long(s.timing.llm_calls, 7, "llm")
            spec.assert_eq_long(s.timing.agent_calls, 0, "missing")
            e = turn_summary.from_json("{}")
            spec.assert_str_eq(e.status, "completed", "default status")
            spec.assert_eq_long(e.steps, 0, "default steps")
        }
    }
    return spec.run_summary(fw)
}
