// upstream src/tui/clipboard.zig has no tests, so there is nothing to port.
// These tests are added: the reader field is replaceable per instance, and
// the shell machinery (read_script: PNG check, exit 127, other failure,
// deadline, size limit) is exercised with stand-in scripts, never the real
// clipboard. The image check is naeb.image's probe, as upstream. Writing text:
// which copier each OS gets, and the text reaching a stand-in copier's stdin.
import std.spec
import std.string
import std.list
import std.fs
import naeb.tui.clipboard

fake_reader_(env: ptr) -> ptr {
    r = heap.new(clipboard.Result)
    r.kind = clipboard.KIND_NO_TOOL
    r.png = ""
    r.error = ""
    return r as ptr
}

main() {
    fw = spec.init()
    spec.describe(fw, "tui.clipboard") {
        spec.it("(extra) the reader is a per-instance field that specs can replace") callback {
            a = clipboard.new()
            b = clipboard.new()
            a.reader = |env: ptr| { return fake_reader_(env) }
            r = clipboard.read_image(a, null) as *clipboard.Result
            spec.assert_eq(r.kind, clipboard.KIND_NO_TOOL, "a is replaced")
            heap.free(r)
            // b still has the system reader: it must not return a's answer.
            // (Not run: it would read the real clipboard.)
            clipboard.free(a)
            clipboard.free(b)
        }
        spec.it("(extra) a script printing a PNG header gives the bytes") callback {
            r = clipboard.read_script("printf '\\211PNG\\r\\n\\032\\n\\000\\000\\000\\rIHDR\\000\\000\\002\\200\\000\\000\\001\\340rest'", null, 2000 as long) as *clipboard.Result
            spec.assert_eq(r.kind, clipboard.KIND_PNG, "png")
            spec.assert_eq(string.length(r.png), 28, "28 bytes")
            spec.assert_eq(r.png[0] & 255, 137, "first byte survives")
            spec.assert_eq(r.png[8] & 255, 0, "NUL bytes survive")
            heap.free(r)
        }
        spec.it("(extra) any image naeb.image probes counts; a bare PNG signature does not") callback {
            g = clipboard.read_script("printf 'GIF89a\\001\\000\\001\\000'", null, 2000 as long) as *clipboard.Result
            spec.assert_eq(g.kind, clipboard.KIND_PNG, "a gif")
            heap.free(g)
            r = clipboard.read_script("printf '\\211PNG\\r\\n\\032\\nrest'", null, 2000 as long) as *clipboard.Result
            spec.assert_eq(r.kind, clipboard.KIND_NO_IMAGE, "no IHDR, no size")
            heap.free(r)
        }
        spec.it("(extra) non-PNG output, exit 127 and other failures") callback {
            r1 = clipboard.read_script("printf 'hello world'", null, 2000 as long) as *clipboard.Result
            spec.assert_eq(r1.kind, clipboard.KIND_NO_IMAGE, "not a png")
            heap.free(r1)
            r2 = clipboard.read_script("exit 127", null, 2000 as long) as *clipboard.Result
            spec.assert_eq(r2.kind, clipboard.KIND_NO_TOOL, "127")
            heap.free(r2)
            r3 = clipboard.read_script("printf '\\211PNG\\r\\n\\032\\n'; exit 1", null, 2000 as long) as *clipboard.Result
            spec.assert_eq(r3.kind, clipboard.KIND_NO_IMAGE, "failing tool")
            heap.free(r3)
        }
        spec.it("(extra) a hung tool is killed at the deadline and counts as no image") callback {
            r = clipboard.read_script("sleep 30", null, 300 as long) as *clipboard.Result
            spec.assert_eq(r.kind, clipboard.KIND_NO_IMAGE, "timed out")
            heap.free(r)
        }
        spec.it("(extra) output beyond the size limit is too large") callback {
            r = clipboard.read_script("head -c 5300000 /dev/zero", null, 5000 as long) as *clipboard.Result
            spec.assert_eq(r.kind, clipboard.KIND_TOO_LARGE, "too large")
            heap.free(r)
        }
        spec.it("(extra) the copier is pbcopy on macOS, upstream's script only under Wayland or X") callback {
            empty_env = list.list_new()
            mac = clipboard.copier("darwin", empty_env)
            spec.assert_true(mac != null, "macOS has one")
            p0, _e = list.get_string(mac, 0)
            spec.assert_str_eq(p0, "/usr/bin/pbcopy", "pbcopy, no shell")
            spec.assert_eq(list.list_size(mac), 1, "no arguments")
            spec.assert_true(clipboard.copier("linux", empty_env) == null, "no display: none")
            x = list.list_new()
            list.list_add(x, "DISPLAY=:0")
            lx = clipboard.copier("linux", x)
            spec.assert_true(lx != null, "X11")
            s2, _e2 = list.get_string(lx, 2)
            spec.assert_str_eq(s2, clipboard.COPY_SCRIPT, "upstream's script")
            w = list.list_new()
            list.list_add(w, "WAYLAND_DISPLAY=wayland-0")
            spec.assert_true(clipboard.copier("linux", w) != null, "Wayland")
        }
        spec.it("(extra) write_text returns at once and the copier gets the text on stdin") callback {
            d, _de = fs.make_temp_dir("", "naeb-copy")
            out = "${d}/got"
            argv = list.list_new()
            list.list_add(argv, "/bin/sh")
            list.list_add(argv, "-c")
            list.list_add(argv, "sleep 0.3; cat > '${out}.part' && mv '${out}.part' '${out}'")
            clipboard.write_text(argv, null, "h\u00e9llo \u2713\nsecond line")
            spec.assert_eq(fs.exists(out), 0, "not waited for")
            waited = 0
            while fs.exists(out) == 0 && waited < 3000 {
                sleep(20)
                waited = waited + 20
            }
            got, _re = fs.read(out)
            spec.assert_str_eq(got, "h\u00e9llo \u2713\nsecond line", "text on stdin")
            fs.remove_tree(d)
        }
    }
    return spec.run_summary(fw)
}
