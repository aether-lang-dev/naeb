// tui.clipboard: reads a PNG from the system clipboard with a shell script and
// a 2 s timeout (upstream src/tui/clipboard.zig).
//
// Differences from upstream:
//  - The test-only global `reader_override` is the `reader` field of a
//    Clipboard instance: new() sets it to the system reader and a spec
//    replaces it (`cb.reader = |env: ptr| {...}`, returning a *Result as ptr).
//    read_image(cb, env) calls it. Its argument is the env list.
//  - Result is a struct {kind, png, error} instead of a union: kind is one of
//    KIND_PNG (png holds the bytes), KIND_NO_TOOL, KIND_NO_IMAGE,
//    KIND_TOO_LARGE; `error` is "" or the spawn error upstream would raise.
//  - The script runs through naeb.tools.process (output to a file, 2 s deadline,
//    killed with its group on timeout) because std.os has no timed capture;
//    that merges stderr into the output, so the Linux branches of the script
//    redirect the tool's stderr to /dev/null (upstream discards it separately).
//    `env` is a list of "NAME=value" or null (inherit); the app passes its
//    environment (config.env.pairs), as upstream passes app.environ.
//  - The image check is naeb.image's probe and MAX_BYTES, as upstream.
//  - read_script(script, env, timeout_ms) is the part below read_image, exposed
//    so the shell/exit-code/timeout handling can be tested with other scripts.
//  - Writing text (upstream selection.zig localCopy) lives here too, since this
//    module already runs the clipboard tools: copier() picks the program and
//    write_text() feeds it the text on stdin on a thread of its own, killed
//    after 1 s (upstream waits up to 1 s for it). Ours, not upstream's: on
//    macOS the copier is /usr/bin/pbcopy, run directly with LC_ALL=en_US.UTF-8
//    (pbcopy reads its input in the locale's encoding and mangles UTF-8
//    without one); upstream copies only through OSC 52 there, which macOS
//    Terminal.app ignores. Elsewhere it is upstream's script, only under
//    Wayland or X.

import std.string
import std.list
import naeb.image
import naeb.tools.process
import std.worker

exports(Result, Clipboard, KIND_PNG, KIND_NO_TOOL, KIND_NO_IMAGE, KIND_TOO_LARGE,
        TIMEOUT_MS, SCRIPT, new, free, read_image, read_script, COPY_SCRIPT, COPY_TIMEOUT_MS, PBCOPY,
        copier, write_text)

const KIND_PNG = 0
const KIND_NO_TOOL = 1
const KIND_NO_IMAGE = 2
const KIND_TOO_LARGE = 3

// A hung clipboard tool must not freeze the UI; its child is killed and the read counts as no image.
const TIMEOUT_MS = 2000

const SCRIPT = "case \"$(uname)\" in
  Darwin)
    f=$(mktemp -t naebclip) || exit 1
    osascript -e 'on run argv' -e 'set d to the clipboard as «class PNGf»' -e 'set f to open for access POSIX file (item 1 of argv) with write permission' -e 'set eof f to 0' -e 'write d to f' -e 'close access f' -e 'end run' \"$f\" >/dev/null 2>&1 && cat \"$f\"
    status=$?
    rm -f \"$f\"
    exit $status ;;
  *)
    if [ -n \"$WAYLAND_DISPLAY\" ] && command -v wl-paste >/dev/null 2>&1; then exec wl-paste --type image/png 2>/dev/null
    elif command -v xclip >/dev/null 2>&1; then exec xclip -selection clipboard -t image/png -o 2>/dev/null
    fi
    exit 127 ;;
esac"

struct Result {
    kind: int
    png: string     // the image bytes when kind is KIND_PNG
    error: string   // "" or why the script could not run
}

struct Clipboard {
    reader: fn      // |env: ptr| -> *Result as ptr
}

result_(kind: int, png: string, error: string) -> ptr {
    r = heap.new(Result)
    r.kind = kind
    r.png = png
    r.error = error
    return r as ptr
}

// Runs `script` under /bin/sh with a deadline; see read_image for the results.
read_script(script: string, env: ptr, timeout_ms: long) -> ptr {
    argv = list.list_new()
    list.list_add(argv, "/bin/sh")
    list.list_add(argv, "-c")
    list.list_add(argv, script)
    pr = process.run(argv, env, null, null, timeout_ms, (image.MAX_BYTES + 1) as long) as *process.Result
    list.list_free(argv)
    if pr.error == "OutputLimit" { return result_(KIND_TOO_LARGE, "", "") }
    if pr.error != "" { return result_(KIND_NO_IMAGE, "", pr.error) }
    if pr.stop == process.STOP_TIMED_OUT { return result_(KIND_NO_IMAGE, "", "") }
    if pr.exit_code == 127 { return result_(KIND_NO_TOOL, "", "") }
    if pr.exit_code != 0 { return result_(KIND_NO_IMAGE, "", "") }
    fmt, _w, _h = image.probe(pr.output)
    if fmt == "" { return result_(KIND_NO_IMAGE, "", "") }
    return result_(KIND_PNG, pr.output, "")
}

// The system clipboard reader new() installs.
system_read_(env: ptr) -> ptr {
    return read_script(SCRIPT, env, TIMEOUT_MS as long)
}

new() -> *Clipboard {
    c = heap.new(Clipboard)
    c.reader = |env: ptr| { return system_read_(env) }
    return c
}

free(c: *Clipboard) { heap.free(c) }

// The PNG on the clipboard: a *Result (as ptr; the caller frees it with heap.free).
read_image(c: *Clipboard, env: ptr) -> ptr {
    ptr r = call(c.reader, env)
    return r
}

// The script upstream's localCopy runs under /bin/sh with the text on stdin.
const COPY_SCRIPT = "if [ -n \"$WAYLAND_DISPLAY\" ] && command -v wl-copy >/dev/null 2>&1; then exec wl-copy\nelif [ -n \"$DISPLAY\" ]; then\n  if command -v xsel >/dev/null 2>&1; then exec xsel --clipboard --input\n  elif command -v xclip >/dev/null 2>&1; then exec xclip -selection clipboard; fi\nfi\nexit 1"
const COPY_TIMEOUT_MS = 1000
const PBCOPY = "/usr/bin/pbcopy"

// The program (argv, a std.list) that puts text on the system clipboard, or
// null for none: pbcopy on macOS; upstream's script when the environment
// ("NAME=value" list, null: this process's) names WAYLAND_DISPLAY or
// DISPLAY, as upstream checks.
copier(platform: string, env: ptr) -> ptr {
    argv = list.list_new()
    if platform == "darwin" || platform == "macos" {
        list.list_add(argv, PBCOPY)
        return argv
    }
    e = env_or_own_(env)
    if has_name_(e, "WAYLAND_DISPLAY") == 0 && has_name_(e, "DISPLAY") == 0 { return null }
    list.list_add(argv, "/bin/sh")
    list.list_add(argv, "-c")
    list.list_add(argv, COPY_SCRIPT)
    return argv
}

env_or_own_(env: @into ptr) -> ptr {
    if env == null { return process.environ() }
    return env
}

has_name_(env: ptr, name: string) -> int {
    prefix = "${name}="
    i = 0
    while i < list.list_size(env) {
        e, _x = list.get_string(env, i)
        if string.starts_with(e, prefix) == 1 { return 1 }
        i = i + 1
    }
    return 0
}

// Starts `argv` (from copier) with `text` on its stdin and returns at once;
// the child is waited for on its own thread and killed after
// COPY_TIMEOUT_MS. A failure is swallowed (upstream `catch {}`). env:
// "NAME=value" list or null (this process's).
write_text(argv: @keep ptr, env: ptr, text: string) {
    base = env_or_own_(env)
    p0, _z = list.get_string(argv, 0)
    e = list.list_new()
    i = 0
    while i < list.list_size(base) {
        v, _x = list.get_string(base, i)
        if p0 != PBCOPY || string.starts_with(v, "LC_ALL=") == 0 { list.list_add(e, v) }
        i = i + 1
    }
    if p0 == PBCOPY { list.list_add(e, "LC_ALL=en_US.UTF-8") }
    input = string.copy(text)
    worker.run_detached(|| {
        r = process.run_lines(argv, e, input, null, COPY_TIMEOUT_MS as long, 100 as long, 4096 as long, null, |ctx: ptr, line: string| {})
        heap.free(r)
        return null
    })
}
