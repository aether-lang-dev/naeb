// Ports upstream src/tools/atomic_file.zig's tests (a2dd439).
import std.spec
import std.fs
import std.string
import std.dir
import naeb.tools.atomic_file

tmp_() -> string {
    d, _e = fs.make_temp_dir("", "naeb-atomic")
    real, _k, _m = fs.realpath(d)
    return real
}

read_(p: string) -> string {
    s, _e = fs.read(p)
    return s
}

mode_(p: string) -> int {
    st, _k, _m = fs.stat(p, 1)
    return st.mode
}

kind_nofollow_(p: string) -> int {
    st, _k, _m = fs.stat(p, 0)
    return st.kind
}

no_temps_(d: string) -> int {
    l, _e = fs.list_dir(d)
    if l == null { return 1 }
    n = fs.dir_list_count(l)
    i = 0
    while i < n {
        if string.starts_with(fs.dir_list_get(l, i), ".naeb-") == 1 { return 0 }
        i = i + 1
    }
    return 1
}

main() {
    fw = spec.init()
    spec.describe(fw, "tools.atomic_file") {
        spec.it("replacement preserves existing permissions and uses creation permissions") callback {
            d = tmp_()
            p = "${d}/file"
            spec.assert_str_eq(atomic_file.replace(p, "first", 384, 0, 0), "", "created")
            spec.assert_eq(mode_(p), 384, "0600")
            modes = [489, 288, 3560]
            i = 0
            while i < 3 {
                fs.chmod(p, modes[i])
                spec.assert_str_eq(atomic_file.replace(p, "replacement", 420, 0, 0), "", "replaced")
                spec.assert_eq(mode_(p), modes[i], "kept mode ${modes[i]}")
                spec.assert_str_eq(read_(p), "replacement", "content")
                i = i + 1
            }
            spec.assert_str_eq(atomic_file.replace(p, "executable", 493, 1, 1), "", "forced")
            spec.assert_eq(mode_(p), 493, "0755")
            spec.assert_eq(no_temps_(d), 1, "no temps")
        }
        spec.it("replacement follows relative absolute and dangling symlinks") callback {
            d = tmp_()
            fs.create_dir("${d}/real")
            fs.symlink("real", "${d}/alias")
            fs.symlink("alias/target", "${d}/link")
            p = "${d}/link"
            spec.assert_str_eq(atomic_file.replace(p, "created", 420, 0, 0), "", "created")
            spec.assert_str_eq(atomic_file.replace(p, "updated", 420, 0, 1), "", "updated")
            spec.assert_eq(kind_nofollow_(p), fs.STAT_KIND_SYMLINK, "link kept")
            spec.assert_str_eq(read_("${d}/real/target"), "updated", "target written")
            target, _e = atomic_file.canonical_path(p)
            fs.symlink(target, "${d}/absolute")
            spec.assert_str_eq(atomic_file.replace("${d}/absolute", "absolute", 420, 0, 0), "", "absolute")
            actual, _e2 = atomic_file.canonical_path("${d}/absolute")
            spec.assert_str_eq(actual, target, "same target")
            spec.assert_eq(kind_nofollow_("${d}/absolute"), fs.STAT_KIND_SYMLINK, "absolute link kept")
            spec.assert_eq(no_temps_(d), 1, "no temps")
        }
        spec.it("canonical paths resolve links before dotdot and normalize missing suffixes") callback {
            d = tmp_()
            fs.mkdir_p("${d}/real/child")
            fs.symlink("real/child", "${d}/alias")
            fs.symlink("alias/../missing/deep", "${d}/dangling")
            expected, _e = atomic_file.canonical_path("${d}/real/missing/deep/file")
            suffixes = ["real/missing/deep/file", "alias/../missing/deep/file", "dangling/./file", "real/missing/other/../deep/file"]
            i = 0
            while i < 4 {
                actual, err = atomic_file.canonical_path("${d}/${suffixes[i]}")
                spec.assert_str_eq(err, "", "no error ${i}")
                spec.assert_str_eq(actual, expected, "same ${suffixes[i]}")
                i = i + 1
            }
            spec.assert_true(string.starts_with(expected, "/"), "absolute")
        }
        spec.it("failed rename cleans temporary file and leaves target intact") callback {
            d = tmp_()
            fs.create_dir("${d}/target")
            fs.write("${d}/target/keep", "original")
            spec.assert_str_eq(atomic_file.replace("${d}/target", "replacement", 420, 0, 0), "IsDir", "IsDir")
            spec.assert_str_eq(read_("${d}/target/keep"), "original", "intact")
            spec.assert_eq(no_temps_(d), 1, "no temps")
        }
        spec.it("symlink loops fail without replacing links or leaving temporary files") callback {
            d = tmp_()
            fs.symlink("b", "${d}/a")
            fs.symlink("a", "${d}/b")
            spec.assert_str_eq(atomic_file.replace("${d}/a", "replacement", 420, 0, 0), "SymLinkLoop", "loop")
            spec.assert_eq(kind_nofollow_("${d}/a"), fs.STAT_KIND_SYMLINK, "link kept")
            spec.assert_eq(no_temps_(d), 1, "no temps")
        }
        spec.it("canonical paths do not traverse regular files as directories") callback {
            d = tmp_()
            fs.write("${d}/plain", "plain")
            fs.write("${d}/victim", "keep")
            fs.symlink("plain", "${d}/link")
            fs.symlink("plain/", "${d}/directory-required")
            cases = ["plain/../victim", "plain/./../victim", "plain/", "link/../victim", "link/", "directory-required"]
            i = 0
            while i < 6 {
                spec.assert_str_eq(atomic_file.replace("${d}/${cases[i]}", "overwrite", 420, 0, 0), "NotDir", "NotDir ${cases[i]}")
                i = i + 1
            }
            spec.assert_str_eq(read_("${d}/plain"), "plain", "plain kept")
            spec.assert_str_eq(read_("${d}/victim"), "keep", "victim kept")
            spec.assert_eq(no_temps_(d), 1, "no temps")
        }
        spec.it("open_verified names the opened file and refuses what is not a file or directory") callback {
            d = tmp_()
            fs.write("${d}/real", "data")
            fs.symlink("real", "${d}/link")
            fd, p, _fold, err = atomic_file.open_verified("${d}/link", atomic_file.WANT_FILE)
            spec.assert_str_eq(err, "", "opened through the link")
            spec.assert_str_eq(p, "${d}/real", "named as the file it opened")
            data, rerr = atomic_file.read_fd(fd, 1024 as long)
            spec.assert_str_eq(rerr, "", "read")
            spec.assert_str_eq(data, "data", "its data")
            atomic_file.close_fd(fd)
            _f2, _p2, _o2, e2 = atomic_file.open_verified("/dev/null", atomic_file.WANT_FILE)
            spec.assert_str_eq(e2, "NotFile", "a device is not a file")
            _f3, _p3, _o3, e3 = atomic_file.open_verified(d, atomic_file.WANT_FILE)
            spec.assert_str_eq(e3, "IsDir", "a directory is not a file")
            fs.write("${d}/big", "0123456789")
            f4, _p4, _o4, _e4 = atomic_file.open_verified("${d}/big", atomic_file.WANT_FILE)
            _d4, r4 = atomic_file.read_fd(f4, 4 as long)
            spec.assert_str_eq(r4, "StreamTooLong", "limit")
            atomic_file.close_fd(f4)
        }
        spec.it("replace_at writes in the opened directory and refuses a symlink leaf") callback {
            d = tmp_()
            fs.mkdir_p("${d}/dir")
            fs.mkdir_p("${d}/elsewhere")
            fs.write("${d}/elsewhere/target", "keep")
            fs.symlink("${d}/elsewhere/target", "${d}/dir/leaf")
            fd, p, _fold, err = atomic_file.open_verified("${d}/dir", atomic_file.WANT_DIR)
            spec.assert_str_eq(err, "", "dir opened")
            _s, werr = atomic_file.replace_at(fd, p, "leaf", "new", 420, 0, 0)
            spec.assert_str_eq(werr, "NotFile", "symlink leaf refused")
            spec.assert_str_eq(read_("${d}/elsewhere/target"), "keep", "target kept")
            _s2, werr2 = atomic_file.replace_at(fd, p, "fresh", "new", 420, 0, 0)
            spec.assert_str_eq(werr2, "", "fresh leaf written")
            spec.assert_str_eq(read_("${d}/dir/fresh"), "new", "its content")
            spec.assert_eq(no_temps_("${d}/dir"), 1, "no temps")
            atomic_file.close_fd(fd)
        }
        spec.it("open_dir makes components only where allowed says so") callback {
            d = tmp_()
            fs.mkdir_p("${d}/ok")
            fd, p, _fold, err = atomic_file.open_dir("${d}/ok/a/b", 1, |dir: string, f: int| {
                if string.contains(dir, "/b") == 1 { return "refused ${dir}" }
                return ""
            })
            spec.assert_eq(fd, -1, "refused")
            spec.assert_true(string.starts_with(err, "refused "), "allowed's reason")
            spec.assert_eq(fs.exists("${d}/ok/a"), 1, "the allowed component made")
            fd2, p2, _f2, e2 = atomic_file.open_dir("${d}/ok/a/c", 1, |dir: string, f: int| { return "" })
            spec.assert_str_eq(e2, "", "made")
            spec.assert_str_eq(p2, "${d}/ok/a/c", "named")
            atomic_file.close_fd(fd2)
        }
    }
    return spec.run_summary(fw)
}
