// The Aether port under ae/: one binary, `naeb`, fenced by the project's
// policy (docs/naeb/adr/0001) unless started with --mode unfenced. Its name is
// set here and nowhere else.

import bldr
import aether
import aether (source, output, lib)
import std.os
import std.fs
import std.list
import std.string

// The Session header's naeb_version carries the commit, as upstream's
// build.zig does: written to a gitignored header the build_info module's C
// side includes when present, with this checkout's path (naeb build
// compiles policies against its ae/policy_lib).
write_commit_() {
    argv = list.list_new()
    list.list_add(argv, "rev-parse")
    list.list_add(argv, "--short")
    list.list_add(argv, "HEAD")
    out, code, err = os.run_capture("git", argv, null)
    c = string.trim(out)
    text = "#define NAEB_COMMIT \"${c}\"\n"
    if err != "" || code != 0 { text = "" }
    text = "${text}#define NAEB_SRC \"${os.getcwd()}\"\n"
    path = "ae/naeb/build_info/commit.h"
    old, rerr = fs.read(path)
    if rerr == "" && old == text { return }
    fs.write(path, text)
}

aeb(cap) {
    write_commit_()
    bldr.build() {
        aether.program() {
            source("ae/naeb_main.ae")
            lib("ae")
            output("naeb")
        }
        aether.program() {
            source("ae/prompt_footprint.ae")
            lib("ae")
            output("prompt-footprint")
        }
        return 0
    }
}
