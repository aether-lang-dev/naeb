// fence: a project's fence against supply-chain attacks
// (docs/naeb/adr/0001). naeb builds one from the project's policy (naeb.ae,
// loaded by nib.fence.policy) and hands it to nib.app; nothing here is
// module state. One Fence drives
// both layers: the in-process tools check paths and hosts against it, and
// every child naeb starts runs inside the jail.Spec it resolves to.
//
//     f = fence.new(home)
//     fence.allow_read(f, "~/.m2/repository")
//     fence.allow_write(f, "~/.m2/repository")
//     fence.allow_host(f, "repo.maven.apache.org", 443)
//     fence.pass_env(f, "JAVA_HOME")
//     fence.set_env(f, "BUNDLE_USER_HOME", "/work/proj/.bundle/user")
//
// Reads: $HOME is closed except the project, the writable roots, the
// allowed paths and ~/.gitconfig; a built-in secrets list stays denied even
// inside them unless allow_read names exactly that path. Writes: the project,
// temp dirs and devices, plus allow_write; .git/hooks, .git/config and
// deny_write paths stay read-only. Egress: only allow_host pairs, through
// naeb's proxy. Environment: an allow-list, pass_env names and set_env pairs.

import std.fs
import std.list
import std.string
import nib.jsonx
import nib.tools.atomic_file
import nib.tools.jail
import nib.tools.rules

exports(Fence, new, open_home, allow_read, deny_read, allow_write, deny_write, allow_host, pass_env,
        set_env, allow_loopback, set_origin, describe, host_allowed, resolve, child_env, proxy_env, read_rules, write_denied, refusal, refusals_json,
        suggestion, SECRETS)

// Relative to $HOME: denied to every fenced reader unless allowed exactly.
const SECRETS[] = [".ssh", ".aws", ".gnupg", ".config/gh", ".config/gcloud", ".azure", ".kube", ".docker",
                   ".netrc", ".git-credentials", ".config/git/credentials", ".npmrc", ".yarnrc", ".pypirc",
                   ".gem/credentials", ".m2/settings.xml", ".m2/settings-security.xml",
                   ".gradle/gradle.properties", ".cargo/credentials", ".cargo/credentials.toml",
                   ".config/hub", ".password-store", ".local/share/keyrings", ".mozilla",
                   ".config/google-chrome", ".config/chromium", ".config/BraveSoftware",
                   "Library/Keychains", "Library/Application Support/Google/Chrome",
                   "Library/Application Support/Firefox", "Library/Application Support/BraveSoftware",
                   "Library/Cookies", ".codex", ".naeb", ".zsh_history", ".bash_history"]
const SECRET_COUNT = 36

// Readable under a closed $HOME without asking: git needs them to run at all.
const HOME_READS[] = [".gitconfig", ".config/git"]
const HOME_READ_COUNT = 2

// Names a fenced child keeps from naeb's environment (plus pass_env names).
const ENV_KEEP[] = ["PATH", "HOME", "USER", "LOGNAME", "SHELL", "TERM", "COLORTERM", "NO_COLOR", "LANG",
                    "LANGUAGE", "TZ", "TMPDIR", "PWD", "JAVA_HOME", "GOPATH", "GOROOT", "CARGO_HOME",
                    "RUSTUP_HOME", "GRADLE_USER_HOME", "MAVEN_HOME", "M2_HOME", "NVM_DIR", "PYENV_ROOT",
                    "VIRTUAL_ENV", "XDG_CACHE_HOME", "XDG_CONFIG_HOME", "XDG_DATA_HOME"]
const ENV_KEEP_COUNT = 27

struct Fence {
    home: string
    home_open: int     // 1: $HOME stays readable except the secrets
    read_allow: ptr    // absolute paths
    read_deny: ptr
    write_allow: ptr
    write_deny: ptr    // absolute, or relative to the project
    hosts: ptr         // "host:port"; a host "*.example.com" matches below it
    env_pass: ptr
    env_set: ptr       // "NAME=value", set for every fenced child
    loopback: int      // macOS: localhost reachable by children
    policy_file: string    // the naeb.ae it was built from, "" for the default fence
    policy_sha256: string
    library: string        // the policy library naeb loaded, ""
    library_sha256: string
}

new(home: string) -> ptr {
    f = heap.new(Fence)
    f.home = string.copy(home)
    f.home_open = 0
    f.read_allow = list.list_new()
    f.read_deny = list.list_new()
    f.write_allow = list.list_new()
    f.write_deny = list.list_new()
    f.hosts = list.list_new()
    f.env_pass = list.list_new()
    f.env_set = list.list_new()
    f.loopback = 0
    f.policy_file = ""
    f.policy_sha256 = ""
    f.library = ""
    f.library_sha256 = ""
    return f as ptr
}

// Copies: a caller may pass getenv() results, which naeb zeroes at start-up.
expand_(f: *Fence, path: string) -> string { return string.copy(jail.expand_home(f.home, path)) }

open_home(fp: ptr) { (fp as *Fence).home_open = 1 }
allow_read(fp: ptr, path: string) { list.list_add((fp as *Fence).read_allow, expand_(fp as *Fence, path)) }
deny_read(fp: ptr, path: string) { list.list_add((fp as *Fence).read_deny, expand_(fp as *Fence, path)) }
allow_write(fp: ptr, path: string) { list.list_add((fp as *Fence).write_allow, expand_(fp as *Fence, path)) }
deny_write(fp: ptr, path: string) { list.list_add((fp as *Fence).write_deny, expand_(fp as *Fence, path)) }
allow_host(fp: ptr, host: string, port: int) { list.list_add((fp as *Fence).hosts, string.copy("${string.to_lower(host)}:${port}")) }
pass_env(fp: ptr, name: string) { list.list_add((fp as *Fence).env_pass, string.copy(name)) }
set_env(fp: ptr, name: string, value: string) { list.list_add((fp as *Fence).env_set, string.copy("${name}=${value}")) }
allow_loopback(fp: ptr) { (fp as *Fence).loopback = 1 }

// Where the fence came from: naeb.ae and the library naeb loaded, with the
// SHA-256s the build record vouched for (nib.fence.policy.start_fence).
set_origin(fp: ptr, file: string, file_sha256: string, library: string, library_sha256: string) {
    f = fp as *Fence
    f.policy_file = string.copy(file)
    f.policy_sha256 = string.copy(file_sha256)
    f.library = string.copy(library)
    f.library_sha256 = string.copy(library_sha256)
}

json_strings_(l: ptr) -> string {
    out = "["
    i = 0
    while i < list.list_size(l) {
        v, _e = list.get_string(l, i)
        if i > 0 { out = "${out}," }
        out = "${out}${jsonx.quote(v)}"
        i = i + 1
    }
    return "${out}]"
}

// The fence in force for a project at `cwd`, as data (tools.fence, the
// TUI's /fence): {platform, policy: {file, sha256, library, library_sha256}
// or null (the default fence), project, home, home_open, reads, read_denied,
// writes, read_only, hosts, loopback, env_passed, env_set}. Paths are
// canonical; reads/read_denied are the read rules both layers apply (the
// last matching rule wins, deeper paths after shallower ones).
describe(fp: ptr, cwd: string, nib_home: string, env: ptr) -> string {
    f = fp as *Fence
    sp = resolve(fp, cwd, nib_home, env) as *jail.Spec
    reads = list.list_new()
    denied = list.list_new()
    ordered = rules.sorted(sp.reads)
    i = 0
    while i < list.list_size(ordered) {
        r, _e = list.get_string(ordered, i)
        if rules.kind_of(r) == rules.DENY { list.list_add(denied, rules.path_of(r)) } else { list.list_add(reads, rules.path_of(r)) }
        i = i + 1
    }
    passed = list.list_new()
    k = 0
    while k < ENV_KEEP_COUNT {
        list.list_add(passed, ENV_KEEP[k])
        k = k + 1
    }
    list.list_add(passed, "LC_*")
    i = 0
    while i < list.list_size(f.env_pass) {
        n, _e2 = list.get_string(f.env_pass, i)
        if has_(passed, n) == 0 { list.list_add(passed, n) }
        i = i + 1
    }
    policy = "null"
    if f.policy_file != "" {
        policy = "{\"file\":${jsonx.quote(f.policy_file)},\"sha256\":${jsonx.quote(f.policy_sha256)},\"library\":${jsonx.quote(f.library)},\"library_sha256\":${jsonx.quote(f.library_sha256)}}"
    }
    platform = jail.os_name()
    ho = "false"
    if f.home_open == 1 { ho = "true" }
    lb = "false"
    if f.loopback == 1 { lb = "true" }
    return "{\"platform\":${jsonx.quote(platform)},\"policy\":${policy},\"project\":${jsonx.quote(canon_(jail.project_root(cwd)))},\"home\":${jsonx.quote(f.home)},\"home_open\":${ho},\"reads\":${json_strings_(reads)},\"read_denied\":${json_strings_(denied)},\"writes\":${json_strings_(sp.writes)},\"read_only\":${json_strings_(sp.write_deny)},\"hosts\":${json_strings_(f.hosts)},\"loopback\":${lb},\"env_passed\":${json_strings_(passed)},\"env_set\":${json_strings_(f.env_set)}}"
}

host_allowed(fp: ptr, host: string, port: int) -> int {
    f = fp as *Fence
    h = string.to_lower(host)
    if string.starts_with(h, "[") == 1 && string.ends_with(h, "]") == 1 { h = string.substring(h, 1, string.length(h) - 1) }
    want = "${h}:${port}"
    n = list.list_size(f.hosts)
    i = 0
    while i < n {
        e, _e = list.get_string(f.hosts, i)
        if e == want { return 1 }
        if string.starts_with(e, "*.") == 1 {
            suffix = string.substring(e, 1, string.length(e))
            if string.ends_with(want, suffix) == 1 { return 1 }
        }
        i = i + 1
    }
    return 0
}

// The canonical form of a path that may not exist yet.
canon_(path: string) -> string {
    c, err = atomic_file.canonical_path(path)
    if err != "" { return path }
    return c
}

has_(l: ptr, s: string) -> int {
    n = list.list_size(l)
    i = 0
    while i < n {
        v, _e = list.get_string(l, i)
        if v == s { return 1 }
        i = i + 1
    }
    return 0
}

add_rule_(out: ptr, kind: string, path: string) {
    r = "${kind}${path}"
    if has_(out, r) == 0 { list.list_add(out, r) }
}

// $HOME as the Fence was given it and the account's home from the user
// database, when they differ: both are closed.
homes_(f: *Fence) -> ptr {
    out = list.list_new()
    if string.length(f.home) > 0 { list.list_add(out, f.home) }
    acct = jail.account_home()
    if string.length(acct) > 0 && canon_(acct) != canon_(f.home) { list.list_add(out, acct) }
    return out
}

// The read rules (tools.rules) for a project at `cwd`, given the writable
// roots and naeb's own data directory.
read_rules(fp: ptr, cwd: string, nib_home: string, writes: ptr) -> ptr {
    f = fp as *Fence
    out = list.list_new()
    allowed = list.list_new()
    i = 0
    while i < list.list_size(f.read_allow) {
        a, _e = list.get_string(f.read_allow, i)
        list.list_add(allowed, canon_(a))
        i = i + 1
    }
    homes = homes_(f)
    h = 0
    while h < list.list_size(homes) {
        home, _eh = list.get_string(homes, h)
        if f.home_open == 0 {
            add_rule_(out, "-", canon_(home))
            k = 0
            while k < HOME_READ_COUNT {
                add_rule_(out, "+", canon_(atomic_file.join(home, HOME_READS[k])))
                k = k + 1
            }
        }
        h = h + 1
    }
    add_rule_(out, "+", canon_(jail.project_root(cwd)))
    i = 0
    while i < list.list_size(writes) {
        w, _e2 = list.get_string(writes, i)
        add_rule_(out, "+", w)
        i = i + 1
    }
    i = 0
    while i < list.list_size(allowed) {
        a2, _e3 = list.get_string(allowed, i)
        add_rule_(out, "+", a2)
        i = i + 1
    }
    h = 0
    while h < list.list_size(homes) {
        home2, _eh2 = list.get_string(homes, h)
        k = 0
        while k < SECRET_COUNT {
            s = canon_(atomic_file.join(home2, SECRETS[k]))
            if has_(allowed, s) == 0 { add_rule_(out, "-", s) }
            k = k + 1
        }
        h = h + 1
    }
    if nib_home != "" {
        nh = canon_(nib_home)
        if has_(allowed, nh) == 0 { add_rule_(out, "-", nh) }
    }
    i = 0
    while i < list.list_size(f.read_deny) {
        d, _e4 = list.get_string(f.read_deny, i)
        add_rule_(out, "-", canon_(d))
        i = i + 1
    }
    return out
}

// Canonical read-only paths inside the writable roots.
write_denied(fp: ptr, cwd: string) -> ptr {
    f = fp as *Fence
    out = list.list_new()
    project = jail.project_root(cwd)
    git = atomic_file.join(project, ".git")
    s, k, _m = fs.stat(git, 1)
    if k == fs.KIND_OK && s.kind == fs.STAT_KIND_DIR {
        hooks = atomic_file.join(git, "hooks")
        if fs.exists(hooks) == 0 { fs.mkdir_p(hooks) }
        list.list_add(out, canon_(hooks))
        list.list_add(out, canon_(atomic_file.join(git, "config")))
    }
    i = 0
    while i < list.list_size(f.write_deny) {
        d, _e = list.get_string(f.write_deny, i)
        p = d
        if string.starts_with(d, "/") == 0 { p = atomic_file.join(project, d) }
        list.list_add(out, canon_(p))
        i = i + 1
    }
    return out
}

// The jail.Spec for a fenced child of a project at `cwd`: writes, read-only
// paths and read rules. The caller fills in the network (the proxy).
// env: the child environment as "NAME=value" (null: this process's).
resolve(fp: ptr, cwd: string, nib_home: string, env: ptr) -> ptr {
    f = fp as *Fence
    extra = list.list_new()
    i = 0
    while i < list.list_size(f.write_allow) {
        w, _e = list.get_string(f.write_allow, i)
        list.list_add(extra, w)
        i = i + 1
    }
    writes = jail.base_roots(cwd, env, extra)
    sp = jail.new_spec(writes)
    s = sp as *jail.Spec
    s.write_deny = write_denied(fp, cwd)
    s.reads = read_rules(fp, cwd, nib_home, writes)
    s.loopback = f.loopback
    return sp
}

keep_(f: *Fence, name: string) -> int {
    k = 0
    while k < ENV_KEEP_COUNT {
        if ENV_KEEP[k] == name { return 1 }
        k = k + 1
    }
    if string.starts_with(name, "LC_") == 1 { return 1 }
    return has_(f.env_pass, name)
}

has_prefix_(l: ptr, prefix: string) -> int {
    n = list.list_size(l)
    i = 0
    while i < n {
        v, _e = list.get_string(l, i)
        if string.starts_with(v, prefix) == 1 { return 1 }
        i = i + 1
    }
    return 0
}

// A fenced child's environment: only the kept names of `base` ("NAME=value"
// list), then the set_env pairs (in place of base's), then the proxy's
// variables when proxy_url is not "".
child_env(fp: ptr, base: ptr, proxy_url: string) -> ptr {
    f = fp as *Fence
    out = list.list_new()
    n = list.list_size(base)
    i = 0
    while i < n {
        e, _e = list.get_string(base, i)
        eq = string.index_of(e, "=")
        if eq > 0 && keep_(f, string.substring(e, 0, eq)) == 1 && has_prefix_(f.env_set, string.substring(e, 0, eq + 1)) == 0 { list.list_add(out, e) }
        i = i + 1
    }
    i = 0
    while i < list.list_size(f.env_set) {
        s, _es = list.get_string(f.env_set, i)
        list.list_add(out, s)
        i = i + 1
    }
    if has_prefix_(out, "HOME=") == 0 && string.length(f.home) > 0 { list.list_add(out, "HOME=${f.home}") }
    if proxy_url != "" {
        pe = proxy_env(proxy_url)
        i = 0
        while i < list.list_size(pe) {
            v, _e2 = list.get_string(pe, i)
            list.list_add(out, v)
            i = i + 1
        }
    }
    return out
}

// What tells curl, git, pip, gem, npm, Node and the JVM about the proxy
// ("http://127.0.0.1:<port>").
proxy_env(proxy_url: string) -> ptr {
    out = list.list_new()
    names = ["HTTP_PROXY", "HTTPS_PROXY", "ALL_PROXY", "http_proxy", "https_proxy", "all_proxy", "npm_config_proxy", "npm_config_https_proxy"]
    k = 0
    while k < 8 {
        list.list_add(out, "${names[k]}=${proxy_url}")
        k = k + 1
    }
    list.list_add(out, "NO_PROXY=")
    list.list_add(out, "no_proxy=")
    list.list_add(out, "NODE_USE_ENV_PROXY=1")
    hostport = string.substring(proxy_url, 7, string.length(proxy_url))
    colon = string.index_of(hostport, ":")
    host = string.substring(hostport, 0, colon)
    port = string.substring(hostport, colon + 1, string.length(hostport))
    list.list_add(out, "JAVA_TOOL_OPTIONS=-Dhttp.proxyHost=${host} -Dhttp.proxyPort=${port} -Dhttps.proxyHost=${host} -Dhttps.proxyPort=${port} -Dhttp.nonProxyHosts=")
    return out
}

// ---- refusals, as the model and the user see them ----
//
// One record for every refusal of the fence, wherever it happened:
//     {"op":"read","resource":"/home/u/.npmrc","layer":"child","command_id":"b3",
//      "suggestion":"policy.allow_read(p, \"~/.npmrc\")"}
// op: read, write, egress (the proxy), network (a direct connection), socket
// (a Unix socket) or the OS's own operation name; layer: "tool" (naeb's
// in-process tools) or "child" (a process naeb started); command_id: the
// command's task id (b3), "hook:<event>", "mcp:<server>", absent for tools.
// suggestion: the naeb.ae line that would allow it, text only, absent where
// no policy line can (naeb's own files, the built-in read-only paths). naeb
// never widens the fence itself: the user edits naeb.ae and runs naeb build.

// path with $HOME as "~", as a policy writes it.
tilde_(f: *Fence, path: string) -> string {
    h = canon_(f.home)
    if path == h { return "~" }
    if string.length(h) > 1 && string.starts_with(path, "${h}/") == 1 { return "~${string.substring(path, string.length(h), string.length(path))}" }
    return path
}

under_(base: string, path: string) -> int {
    if path == base { return 1 }
    if base == "/" { return 1 }
    return string.starts_with(path, "${base}/")
}

under_any_(l: ptr, path: string) -> int {
    i = 0
    while i < list.list_size(l) {
        b, _e = list.get_string(l, i)
        if under_(canon_(b), path) == 1 { return 1 }
        i = i + 1
    }
    return 0
}

// The naeb.ae line that would allow `op` on `resource`, or "".
suggestion(fp: ptr, cwd: string, nib_home: string, op: string, resource: string) -> string {
    f = fp as *Fence
    if op == "egress" {
        colon = -1
        i = string.length(resource) - 1
        while i >= 0 {
            if string.char_at(resource, i) == 58 {
                colon = i
                break
            }
            i = i - 1
        }
        if colon <= 0 { return "" }
        host = string.substring(resource, 0, colon)
        if string.starts_with(host, "[") == 1 && string.ends_with(host, "]") == 1 { host = string.substring(host, 1, string.length(host) - 1) }
        return "policy.allow_host(p, ${jsonx.quote(host)}, ${string.substring(resource, colon + 1, string.length(resource))})"
    }
    if op != "read" && op != "write" { return "" }
    if string.starts_with(resource, "/") == 0 { return "" }
    path = canon_(resource)
    own = atomic_file.join(f.home, ".naeb")
    if under_(canon_(own), path) == 1 { return "" }
    if nib_home != "" && under_(canon_(nib_home), path) == 1 { return "" }
    if op == "read" {
        if under_any_(f.read_deny, path) == 1 { return "" }
        return "policy.allow_read(p, ${jsonx.quote(tilde_(f, path))})"
    }
    project = canon_(jail.project_root(cwd))
    if under_(project, path) == 1 {
        // Inside the project only the built-in or the policy's read-only paths refuse a write.
        return ""
    }
    if under_any_(f.write_deny, path) == 1 { return "" }
    return "policy.allow_write(p, ${jsonx.quote(tilde_(f, path))})"
}

// One refusal record (above) as JSON. entry: "op resource".
refusal(fp: ptr, cwd: string, nib_home: string, entry: string, layer: string, command_id: string) -> string {
    sp = string.index_of(entry, " ")
    op = entry
    resource = ""
    if sp > 0 {
        op = string.substring(entry, 0, sp)
        resource = string.substring(entry, sp + 1, string.length(entry))
    }
    out = "{\"op\":${jsonx.quote(op)},\"resource\":${jsonx.quote(resource)},\"layer\":${jsonx.quote(layer)}"
    if command_id != "" { out = "${out},\"command_id\":${jsonx.quote(command_id)}" }
    sug = suggestion(fp, cwd, nib_home, op, resource)
    if sug != "" { out = "${out},\"suggestion\":${jsonx.quote(sug)}" }
    return "${out}}"
}

// The records of `entries` ("op resource" each) as a JSON array, "" when empty.
refusals_json(fp: ptr, cwd: string, nib_home: string, entries: ptr, layer: string, command_id: string) -> string {
    n = list.list_size(entries)
    if n == 0 { return "" }
    out = "["
    i = 0
    while i < n {
        e, _e = list.get_string(entries, i)
        if i > 0 { out = "${out}," }
        out = "${out}${refusal(fp, cwd, nib_home, e, layer, command_id)}"
        i = i + 1
    }
    return "${out}]"
}
