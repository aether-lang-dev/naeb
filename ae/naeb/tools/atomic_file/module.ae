// tools.atomic_file: canonical paths and atomic same-directory replacement
// (upstream src/tools/atomic_file.zig). Errors are Zig's names for them
// ("FileNotFound", "NotDir", "SymLinkLoop", ...), which tool errors show.
//
// Descriptor-relative access (docs/naeb/adr/0001, "Path identity"): a
// checked path is opened first and decided on as opened: open_verified
// gives the path the descriptor really names (on-disk case, firmlinks and
// /.vol mapped back, no symlinks) and whether its volume folds case;
// open_dir opens (and makes) a directory one verified component at a time;
// replace_at writes beside a leaf of an opened directory and renames over
// it there, so a symlink swapped in after the check redirects nothing.

import std.fs
import std.os hiding (exec, run_capture, run_pipe, run_pipe_drain_and_wait, run_socket,
    run_stdio, run_full, run_supervised, spawn_proc, spawn_proc_to, os_system,
    os_exec_raw, os_execv, os_run, os_run_capture_raw, os_run_capture_status_raw,
    os_run_pipe_raw, os_run_pipe_drain_and_wait_raw, os_run_socket_raw,
    os_run_stdio_raw, os_run_full_raw, os_run_supervised_raw, os_spawn_raw,
    os_spawn_to_raw)
import std.string
import std.list
import std.cryptography
import std.io
import naeb.fserr

@source("pathfd.c")

exports(canonical_path, replace, replace_stat, dirname, basename, join, cwd_path,
        open_verified, open_dir, open_leaf, open_child, read_fd, close_fd, fd_kind, replace_at, list_fd, kind_at, cloexec_inherited,
        WANT_FILE, WANT_DIR, WANT_ANY)

extern naebfs_open(path: string, kind: int, nofollow: int) -> int
extern naebfs_openat(dirfd: int, name: string, kind: int, nofollow: int) -> int
extern naebfs_close(fd: int) -> int
extern naebfs_fd_kind(fd: int) -> int
extern naebfs_kind_at(dirfd: int, name: string) -> int
extern naebfs_mode_at(dirfd: int, name: string) -> int
extern naebfs_same(fd: int, path: string) -> int
extern naebfs_fd_path(fd: int) -> string @heap
extern naebfs_fd_fold(fd: int) -> int
extern naebfs_mkdirat(dirfd: int, name: string, mode: int) -> int
extern naebfs_create_at(dirfd: int, name: string, mode: int) -> int
extern naebfs_rename_at(dirfd: int, from: string, to: string) -> int
extern naebfs_unlink_at(dirfd: int, name: string) -> int
extern naebfs_list(fd: int) -> string @heap
extern naebfs_errname(neg: int) -> string
extern naebfs_cloexec_inherited() -> int

const WANT_FILE = 0
const WANT_DIR = 1
const WANT_ANY = 2
const KIND_FILE = 1
const KIND_DIR = 2
const KIND_LINK = 3

const MAX_LINKS = 40

cwd_path() -> string {
    c = os.getcwd()
    return c
}

// "/a/b" -> "/a"; "/a" -> "/"; "/" -> "/".
dirname(p: string) -> string {
    n = string.length(p)
    while n > 1 && string.char_at(p, n - 1) == 47 { n = n - 1 }
    i = n - 1
    while i >= 0 && string.char_at(p, i) != 47 { i = i - 1 }
    if i <= 0 { return "/" }
    return string.substring(p, 0, i)
}

basename(p: string) -> string {
    n = string.length(p)
    while n > 1 && string.char_at(p, n - 1) == 47 { n = n - 1 }
    i = n - 1
    while i >= 0 && string.char_at(p, i) != 47 { i = i - 1 }
    return string.substring(p, i + 1, n)
}

join(a: string, b: string) -> string {
    if string.ends_with(a, "/") == 1 { return "${a}${b}" }
    return "${a}/${b}"
}

// The components of p ("." and ".." kept, empty ones dropped).
components_(p: string) -> ptr {
    out = list.list_new()
    n = string.length(p)
    i = 0
    while i < n {
        while i < n && string.char_at(p, i) == 47 { i = i + 1 }
        if i >= n { break }
        j = i
        while j < n && string.char_at(p, j) != 47 { j = j + 1 }
        list.list_add(out, string.substring(p, i, j))
        i = j
    }
    return out
}

// Absolute path with every symlink resolved and . / .. applied in order; a
// missing suffix is allowed. (path, "") or ("", error name).
canonical_path(path: string) -> (string, string) {
    if string.length(path) == 0 { return "", "FileNotFound" }
    resolved = "/"
    pending = path
    if string.starts_with(path, "/") == 0 {
        resolved = cwd_path()
    }
    links = 0
    // Process pending's components; a symlink restarts with its target + rest.
    comps = components_(pending)
    idx = 0
    total = list.list_size(comps)
    while idx < total {
        name, _ge = list.get_string(comps, idx)
        is_last = 0
        if idx == total - 1 { is_last = 1 }
        idx = idx + 1
        if name == "." { continue }
        if name == ".." {
            resolved = dirname(resolved)
            continue
        }
        candidate = join(resolved, name)
        st, sk, _sm = fs.stat(candidate, 0)
        if sk != fs.KIND_OK {
            name_err = fserr.errname(sk)
            if name_err == "FileNotFound" {
                resolved = candidate
                continue
            }
            return "", name_err
        }
        if st.kind != fs.STAT_KIND_SYMLINK {
            if is_last == 0 {
                if st.kind != fs.STAT_KIND_DIR { return "", "NotDir" }
            }
            resolved = candidate
            continue
        }
        links = links + 1
        if links > MAX_LINKS { return "", "SymLinkLoop" }
        target, lerr = fs.readlink(candidate)
        if lerr != "" { return "", "Unexpected" }
        // target + the rest of the components
        rest = ""
        k = idx
        while k < total {
            rc_, _ge2 = list.get_string(comps, k)
            rest = "${rest}/${rc_}"
            k = k + 1
        }
        if string.ends_with(pending, "/") == 1 && total > 0 { rest = "${rest}/" }
        pending = "${target}${rest}"
        if string.starts_with(target, "/") == 1 { resolved = "/" }
        comps = components_(pending)
        total = list.list_size(comps)
        idx = 0
    }
    // A trailing "/", "." or ".." requires a directory.
    last = basename(pending)
    if string.ends_with(pending, "/") == 1 || last == "." || last == ".." {
        rst, rk, _rm = fs.stat(resolved, 1)
        if rk != fs.KIND_OK { return "", fserr.errname(rk) }
        if rst.kind != fs.STAT_KIND_DIR { return "", "NotDir" }
    }
    return resolved, ""
}

random_name_() -> string {
    hex, _e = cryptography.random_hex(16)
    return ".naeb-${hex}"
}

none_() -> fs.Stat {
    return fs.Stat { kind: 0, mode: 0, nlink: 0, ino: 0, dev: 0, size: 0, mtime_ns: 0 }
}

// Writes data to a fresh .naeb-* file beside the canonical target and renames
// it over the target. An existing target keeps its permission bits unless
// force_mode; a new one gets `mode` (subject to umask). "" or the error name.
replace(path: string, data: string, mode: int, force_mode: int, sync: int) -> string {
    _st, err = replace_stat(path, data, mode, force_mode, sync)
    return err
}

// replace, returning the written file's Stat (a zeroed one with an error).
replace_stat(path: string, data: string, mode: int, force_mode: int, sync: int) -> (fs.Stat, string) {
    target, err = canonical_path(path)
    if err != "" { return none_(), err }
    dir = dirname(target)
    dst, dk, _dm = fs.stat(dir, 1)
    if dk != fs.KIND_OK { return none_(), fserr.errname(dk) }
    if dst.kind != fs.STAT_KIND_DIR { return none_(), "NotDir" }
    existing = 0
    existing_mode = 0
    tst, tk, _tm = fs.stat(target, 1)
    if tk == fs.KIND_OK {
        if tst.kind != fs.STAT_KIND_FILE && tst.kind != fs.STAT_KIND_DIR { return none_(), "NotFile" }
        existing = 1
        existing_mode = tst.mode
    } else if tk != fs.KIND_NOT_FOUND {
        return none_(), fserr.errname(tk)
    }
    create_mode = mode
    if existing == 1 { create_mode = 384 }
    fd = -1
    name = ""
    tries = 0
    while tries < 16 {
        name = join(dir, random_name_())
        cfd, ck, _cm = fs.create_exclusive(name, create_mode)
        fd = cfd
        if fd >= 0 { break }
        if ck != fs.KIND_EXISTS { return none_(), fserr.errname(ck) }
        tries = tries + 1
    }
    if fd < 0 { return none_(), "PathAlreadyExists" }
    _w, wk, _wm = fs.fd_pwrite_all(fd, string.bytes(data), 0 as long)
    if wk == fs.KIND_OK && existing == 1 && force_mode == 0 { _f, wk, _fm = fs.fchmod(fd, existing_mode) }
    if wk == fs.KIND_OK && force_mode == 1 { _f2, wk, _fm2 = fs.fchmod(fd, mode) }
    if wk == fs.KIND_OK && sync == 1 { _y, wk, _ym = fs.fd_fsync(fd) }
    failed = ""
    if wk != fs.KIND_OK { failed = fserr.errname(wk) }
    io.fd_close(fd)
    if failed != "" {
        fs.unlink(name)
        return none_(), failed
    }
    written, _ok, _om = fs.stat(name, 1)
    _mv, mk, _mm = fs.move(name, target)
    if mk != fs.KIND_OK {
        failed = fserr.errname(mk)
        fs.unlink(name)
        return none_(), failed
    }
    return written, ""
}

// ---- descriptor-relative access ----

close_fd(fd: int) {
    if fd >= 0 { naebfs_close(fd) }
}

errname_(neg: int) -> string { return string.copy(naebfs_errname(neg)) }

// The path `fd` names, or the fallback when the OS cannot say and the
// fallback is that very file; "" otherwise.
fd_path_(fd: int, fallback: string) -> string {
    p = naebfs_fd_path(fd)
    if string.length(p) > 0 { return p }
    if fallback != "" && naebfs_same(fd, fallback) == 1 { return fallback }
    return ""
}

// Checks an opened descriptor's kind against `want` and names it: (fd,
// path, fold, "") or (-1, "", 0, error) with fd closed.
verify_(fd: int, want: int, fallback: string) -> (int, string, int, string) {
    k = naebfs_fd_kind(fd)
    bad = ""
    if k < 0 { bad = errname_(k) } else if want == WANT_FILE && k == KIND_DIR { bad = "IsDir" } else if want == WANT_DIR && k != KIND_DIR {
        bad = "NotDir"
    } else if k != KIND_FILE && k != KIND_DIR { bad = "NotFile" }
    if bad != "" {
        naebfs_close(fd)
        return -1, "", 0, bad
    }
    p = fd_path_(fd, fallback)
    if p == "" {
        naebfs_close(fd)
        return -1, "", 0, "AccessDenied"
    }
    return fd, p, naebfs_fd_fold(fd), ""
}

// Opens `path` (a regular file, a directory or either: WANT_*) without
// blocking on a FIFO or device: (fd, the path the descriptor names, 1 when
// its volume folds case, "") or (-1, "", 0, error name). Anything but a
// regular file or a directory is "NotFile". Close with close_fd.
open_verified(path: string, want: int) -> (int, string, int, string) {
    kind = 0
    if want == WANT_DIR { kind = 1 }
    fd = naebfs_open(path, kind, 0)
    if fd < 0 { return -1, "", 0, errname_(fd) }
    return verify_(fd, want, path)
}

// The leaf `name` of the opened directory `dirfd` (whose path is `dir`),
// opened without following a symlink, as open_verified.
open_leaf(dirfd: int, dir: string, name: string, want: int) -> (int, string, int, string) {
    kind = 0
    if want == WANT_DIR { kind = 1 }
    fd = naebfs_openat(dirfd, name, kind, 1)
    if fd < 0 { return -1, "", 0, errname_(fd) }
    return verify_(fd, want, join(dir, name))
}

// open_leaf for a walk: the entry `name` of the opened, already verified
// directory `dirfd` (path `dir`), opened without following a symlink, is
// `dir`/`name` by construction, so its path is not asked of the OS.
open_child(dirfd: int, dir: string, name: string, want: int) -> (int, string, int, string) {
    kind = 0
    if want == WANT_DIR { kind = 1 }
    fd = naebfs_openat(dirfd, name, kind, 1)
    if fd < 0 { return -1, "", 0, errname_(fd) }
    k = naebfs_fd_kind(fd)
    if (want == WANT_DIR && k != KIND_DIR) || (want == WANT_FILE && k != KIND_FILE) || k < 0 {
        naebfs_close(fd)
        return -1, "", 0, "NotFile"
    }
    return fd, join(dir, name), naebfs_fd_fold(fd), ""
}

// The directory `path` (canonical, absolute) opened, its missing
// components made first when `create` is 1: (fd, the path it names, fold,
// "") or (-1, "", 0, error). `allowed(dir: string, fold: int) -> string`
// ("" or why not) is asked of the deepest existing directory before
// anything is made in it, and of each directory made, as opened; nothing
// is made in a directory it refuses. A component is opened from its opened
// parent without following a symlink.
open_dir(path: string, create: int, allowed: fn) -> (int, string, int, string) {
    base = path
    missing = list.list_new()
    if create == 1 {
        while base != "/" {
            st, k, _m = fs.stat(base, 1)
            if k == fs.KIND_OK && st.kind == fs.STAT_KIND_DIR { break }
            if k == fs.KIND_OK { return -1, "", 0, "${base}: NotDir" }
            if k != fs.KIND_NOT_FOUND { return -1, "", 0, "${base}: ${fserr.errname(k)}" }
            list.list_add(missing, basename(base))
            base = dirname(base)
        }
    }
    fd, dir, fold, err = open_verified(base, WANT_DIR)
    if err != "" { return -1, "", 0, "${base}: ${err}" }
    string why = call(allowed, dir, fold)
    if why != "" {
        naebfs_close(fd)
        return -1, "", 0, why
    }
    i = list.list_size(missing) - 1
    while i >= 0 {
        name, _e = list.get_string(missing, i)
        mk = naebfs_mkdirat(fd, name, 511)
        if mk < 0 && errname_(mk) != "PathAlreadyExists" {
            naebfs_close(fd)
            return -1, "", 0, "${join(dir, name)}: ${errname_(mk)}"
        }
        cfd, cdir, cfold, cerr = open_leaf(fd, dir, name, WANT_DIR)
        naebfs_close(fd)
        if cerr != "" { return -1, "", 0, "${join(dir, name)}: ${cerr}" }
        string cwhy = call(allowed, cdir, cfold)
        if cwhy != "" {
            naebfs_close(cfd)
            return -1, "", 0, cwhy
        }
        fd = cfd
        dir = cdir
        fold = cfold
        i = i - 1
    }
    return fd, dir, fold, ""
}

// The kind of the open `fd`: 1 file, 2 directory, 4 other; negative on an error.
fd_kind(fd: int) -> int { return naebfs_fd_kind(fd) }

// The kind of `name` in the opened directory, not followed: 0 absent,
// 1 file, 2 directory, 3 symlink, 4 other; negative on an error.
kind_at(dirfd: int, name: string) -> int { return naebfs_kind_at(dirfd, name) }

// Everything `fd` reads up to EOF: (data, "") or ("", "StreamTooLong")
// past `limit` bytes, or ("", error).
read_fd(fd: int, limit: long) -> (string, string) {
    size, sk, _sm = fs.fd_size(fd)
    chunk = 65536
    if sk == fs.KIND_OK && size > 0 {
        if size > limit { return "", "StreamTooLong" }
        chunk = (size as int) + 1
    }
    data = ""
    total = 0 as long
    while true {
        part, n, err = io.fd_read_n(fd, chunk)
        if err != "" { return "", "AccessDenied" }
        if n == 0 { break }
        if total == 0 { data = part } else { data = string.concat(data, part) }
        total = total + (n as long)
        if total > limit { return "", "StreamTooLong" }
        if n < chunk { break }
        chunk = 65536
    }
    return data, ""
}

// The entries of the opened directory `fd`: a list of "<kind><name>", kind
// f(ile), d(irectory), l(ink), o(ther) or u(nknown).
list_fd(fd: int) -> ptr {
    text = naebfs_list(fd)
    out = list.list_new()
    n = string.length(text)
    i = 0
    while i < n {
        j = string.index_of_from(text, "/", i)
        if j < 0 { break }
        list.list_add(out, string.substring(text, i, j))
        i = j + 1
    }
    return out
}

// Writes `data` to a fresh .naeb-* file in the opened directory `dirfd`
// (its path `dir`) and renames it over the leaf `name` there; a symlink or
// anything but a regular file at the leaf is refused ("NotFile"). Modes as
// replace_stat. (the written file's Stat, "") or (zeroed, error name).
replace_at(dirfd: int, dir: string, name: string, data: string, mode: int, force_mode: int, sync: int) -> (fs.Stat, string) {
    k = naebfs_kind_at(dirfd, name)
    if k < 0 { return none_(), errname_(k) }
    if k != 0 && k != KIND_FILE { return none_(), "NotFile" }
    existing = 0
    existing_mode = 0
    if k == KIND_FILE {
        m = naebfs_mode_at(dirfd, name)
        if m < 0 { return none_(), errname_(m) }
        existing = 1
        existing_mode = m
    }
    create_mode = mode
    if existing == 1 { create_mode = 384 }
    fd = -1
    tmp = ""
    tries = 0
    while tries < 16 {
        tmp = random_name_()
        fd = naebfs_create_at(dirfd, tmp, create_mode)
        if fd >= 0 { break }
        if errname_(fd) != "PathAlreadyExists" { return none_(), errname_(fd) }
        tries = tries + 1
    }
    if fd < 0 { return none_(), "PathAlreadyExists" }
    _w, wk, _wm = fs.fd_pwrite_all(fd, string.bytes(data), 0 as long)
    if wk == fs.KIND_OK && existing == 1 && force_mode == 0 { _f, wk, _fm = fs.fchmod(fd, existing_mode) }
    if wk == fs.KIND_OK && force_mode == 1 { _f2, wk, _fm2 = fs.fchmod(fd, mode) }
    if wk == fs.KIND_OK && sync == 1 { _y, wk, _ym = fs.fd_fsync(fd) }
    failed = ""
    if wk != fs.KIND_OK { failed = fserr.errname(wk) }
    io.fd_close(fd)
    if failed != "" {
        naebfs_unlink_at(dirfd, tmp)
        return none_(), failed
    }
    rk = naebfs_rename_at(dirfd, tmp, name)
    if rk < 0 {
        naebfs_unlink_at(dirfd, tmp)
        return none_(), errname_(rk)
    }
    written, _ok, _om = fs.stat(join(dir, name), 0)
    return written, ""
}

// Marks every inherited descriptor above 2 close-on-exec, so no child ever
// receives one; how many it marked.
cloexec_inherited() -> int { return naebfs_cloexec_inherited() }
