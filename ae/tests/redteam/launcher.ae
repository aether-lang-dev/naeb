// The red-team fixtures' launcher (docs/naeb/adr/0001): naeb with a fence
// that allows one host, the fixture's "allowed" listener, named by
// NAEB_REDTEAM_ALLOWED as host:port. A project's real launcher is the same
// shape with its hosts and paths written out.

import std.os
import std.string
import nib.app
import nib.fence

port_of_(s: string) -> int {
    v = 0
    i = 0
    while i < string.length(s) {
        c = string.char_at(s, i)
        if c < 48 || c > 57 { return 0 }
        v = v * 10 + (c - 48)
        i = i + 1
    }
    return v
}

main() {
    home = os.getenv("HOME")
    if home == null { home = "" }
    f = fence.new(home)
    allowed = os.getenv("NAEB_REDTEAM_ALLOWED")
    if allowed != null {
        colon = string.index_of(allowed, ":")
        if colon > 0 {
            fence.allow_host(f, string.substring(allowed, 0, colon), port_of_(string.substring(allowed, colon + 1, string.length(allowed))))
        }
    }
    app.run(f)
}
