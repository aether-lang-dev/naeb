// tools.jail: bash's OS write sandbox, workspace mode (upstream
// src/tools/bash/jail.zig, ADR 0004). Writable roots: the project (first
// ancestor of cwd with .git), a linked worktree's git dirs, temp dirs, a few
// devices, the cache allowlist, user extras; reads and network stay open.
// macOS: sandbox-exec with a per-command profile. Linux: `naeb __jail
// [-w <root>]... -- <command>...`, which restricts itself with Landlock and
// execs the command. No module state: a probe result is cached by the caller.
//
// A project fence (docs/naeb/adr/0001, naeb.fence) arrives as a *Spec: write
// roots, read-only paths inside them, read rules (tools.rules) and egress
// through naeb's proxy. Linux: the helper's -W/-r/-R/--net options (a user,
// mount and network namespace, Landlock reads, a relay to the proxy's Unix
// socket); macOS: the same Spec as one SBPL profile.

import std.fs
import std.dir
import std.os
import std.string
import std.list
import naeb.tools.atomic_file
import naeb.tools.rules

@source("landlock.c")

exports(HELPER_COMMAND, SANDBOX_EXEC, RELAY_PORT, Spec, new_spec, project_root, roots, base_roots, allows, expand_home, profile,
        spec_profile, landlock_reads, scrub_environ, cloexec_inherited, account_home, unavailable, unavailable_text, fence_unavailable, proxy_url, wrap, wrap_spec, helper, os_name)

const HELPER_COMMAND = "__jail"
const SANDBOX_EXEC = "/usr/bin/sandbox-exec"
// Inside a fenced Linux child's network namespace: the relay to the proxy.
const RELAY_PORT = 3128

extern naebjail_probe() -> int
extern naebjail_abi() -> int
extern naebjail_probe_userns() -> int
extern naebjail_restrict(roots: string) -> int
extern naebjail_fence(writes: string, wdeny: string, reads: string, reads_on: int, sock: string, report: string) -> int
extern naebjail_scrub_environ() -> int
extern naebjail_account_home() -> string

struct Spec {
    writes: ptr        // canonical writable roots
    write_deny: ptr    // canonical paths inside them that stay read-only
    reads: ptr         // read rules (tools.rules), or null: reads stay open
    net: int           // 1: no network but naeb's egress proxy
    proxy_port: int    // macOS: the proxy's port on 127.0.0.1
    proxy_sock: string // Linux: the proxy's Unix socket
    loopback: int      // macOS: localhost stays reachable
    deny_tag: string   // macOS: the message the profile's denials are logged with, or ""
    deny_report: string // Linux: the file the helper names refusals in, or ""
}

new_spec(writes: @keep ptr) -> ptr {
    s = heap.new(Spec)
    s.writes = writes
    s.write_deny = list.list_new()
    s.reads = null
    s.net = 0
    s.proxy_port = 0
    s.proxy_sock = ""
    s.loopback = 0
    s.deny_tag = ""
    s.deny_report = ""
    return s as ptr
}

home_caches_() -> ptr {
    l = list.list_new()
    names = [".cache", "Library/Caches", "Library/Developer", ".npm", ".cargo/registry", ".cargo/git", ".rustup", "go/pkg", ".gradle", ".m2", ".bun/install/cache", ".yarn", ".pnpm-store", ".local/share/pnpm", ".local/share/uv"]
    mac = 0
    if is_mac_() == 1 { mac = 1 }
    i = 0
    while i < 15 {
        if mac == 1 || (i != 1 && i != 2) { list.list_add(l, names[i]) }
        i = i + 1
    }
    return l
}

system_paths_() -> ptr {
    l = list.list_new()
    if is_mac_() == 1 {
        p = ["/tmp", "/var/tmp", "/private/tmp", "/private/var/tmp", "/private/var/folders", "/dev/null", "/dev/zero", "/dev/tty", "/dev/ptmx", "/dev/dtracehelper", "/dev/fd"]
        i = 0
        while i < 11 {
            list.list_add(l, p[i])
            i = i + 1
        }
    } else {
        p = ["/tmp", "/var/tmp", "/dev/null", "/dev/zero", "/dev/full", "/dev/tty", "/dev/ptmx", "/dev/pts", "/dev/shm"]
        i = 0
        while i < 9 {
            list.list_add(l, p[i])
            i = i + 1
        }
    }
    return l
}

// The first ancestor of cwd (inclusive) holding a .git, else cwd.
project_root(cwd: string) -> string {
    path = cwd
    while true {
        if fs.exists(atomic_file.join(path, ".git")) == 1 { return path }
        if path == "/" { return cwd }
        path = atomic_file.dirname(path)
    }
    return cwd
}

contains_(l: ptr, s: string) -> int {
    n = list.list_size(l)
    i = 0
    while i < n {
        v, _e = list.get_string(l, i)
        if v == s { return 1 }
        i = i + 1
    }
    return 0
}

add_(out: ptr, path: string) {
    if string.starts_with(path, "/") == 0 { return }
    real, _k, err = fs.realpath(path)
    if err != "" { return }
    if string.length(real) == 0 { return }
    if contains_(out, real) == 1 { return }
    list.list_add(out, real)
}

trim_(s: string) -> string { return string.trim(s) }

// A linked worktree keeps its git state outside the project directory.
add_git_dirs_(out: ptr, project: string) {
    text, err = fs.read(atomic_file.join(project, ".git"))
    if err != "" { return }
    if string.length(text) > 4096 { return }
    line = trim_(text)
    if string.starts_with(line, "gitdir:") == 0 { return }
    raw = trim_(string.substring(line, 7, string.length(line)))
    git_dir = raw
    if string.starts_with(raw, "/") == 0 { git_dir = atomic_file.join(project, raw) }
    add_(out, git_dir)
    common, cerr = fs.read(atomic_file.join(git_dir, "commondir"))
    if cerr != "" { return }
    rel = trim_(common)
    if string.starts_with(rel, "/") == 1 { add_(out, rel) } else { add_(out, atomic_file.join(git_dir, rel)) }
}

env_(env: ptr, name: string) -> string {
    // env: list of "NAME=value", or null for this process's own
    if env == null {
        v = os.getenv(name)
        if v == null { return "" }
        return v
    }
    prefix = "${name}="
    n = list.list_size(env)
    i = 0
    while i < n {
        e, _x = list.get_string(env, i)
        if string.starts_with(e, prefix) == 1 { return string.substring(e, string.length(prefix), string.length(e)) }
        i = i + 1
    }
    return ""
}

// The project (and a linked worktree's git dirs), temp dirs and devices,
// then the extras: a fence's writable roots, without the cache allowlist.
base_roots(cwd: string, env: ptr, extra: ptr) -> ptr {
    out = list.list_new()
    add_base_(out, cwd, env)
    add_extra_(out, extra)
    return out
}

add_base_(out: ptr, cwd: string, env: ptr) {
    project = project_root(cwd)
    add_(out, project)
    add_git_dirs_(out, project)
    sp = system_paths_()
    i = 0
    while i < list.list_size(sp) {
        s, _e = list.get_string(sp, i)
        add_(out, s)
        i = i + 1
    }
    tmp = env_(env, "TMPDIR")
    if tmp != "" { add_(out, tmp) }
}

add_extra_(out: ptr, extra: ptr) {
    if extra == null { return }
    i = 0
    while i < list.list_size(extra) {
        x, _e3 = list.get_string(extra, i)
        add_(out, x)
        i = i + 1
    }
}

// Canonical writable roots; candidates that do not exist are dropped.
// env: the child environment as "NAME=value" (null: this process's).
roots(cwd: string, home: string, env: ptr, extra: ptr) -> ptr {
    out = list.list_new()
    add_base_(out, cwd, env)
    if string.length(home) > 0 {
        hc = home_caches_()
        i = 0
        while i < list.list_size(hc) {
            rel, _e2 = list.get_string(hc, i)
            add_(out, atomic_file.join(home, rel))
            i = i + 1
        }
    }
    names = ["XDG_CACHE_HOME", "ZIG_GLOBAL_CACHE_DIR", "RUSTUP_HOME", "GOCACHE", "GOMODCACHE", "GRADLE_USER_HOME", "npm_config_cache", "PIP_CACHE_DIR", "UV_CACHE_DIR"]
    i = 0
    while i < 9 {
        v = env_(env, names[i])
        if v != "" { add_(out, v) }
        i = i + 1
    }
    cargo = env_(env, "CARGO_HOME")
    if cargo != "" {
        add_(out, atomic_file.join(cargo, "registry"))
        add_(out, atomic_file.join(cargo, "git"))
    }
    gopath = env_(env, "GOPATH")
    if gopath != "" { add_(out, atomic_file.join(gopath, "pkg")) }
    add_extra_(out, extra)
    return out
}

// 1 when canonical lies inside one of the roots, by whole components.
allows(writable: ptr, canonical: string) -> int { return rules.inside(writable, canonical) }

expand_home(home: string, path: string) -> string {
    if path == "~" { return home }
    if string.starts_with(path, "~/") == 1 { return atomic_file.join(home, string.substring(path, 2, string.length(path))) }
    return path
}

sbpl_str_(path: string) -> string {
    esc = ""
    k = 0
    pn = string.length(path)
    while k < pn {
        c = string.char_at(path, k)
        if c == 34 || c == 92 { esc = "${esc}\\" }
        if c >= 32 { esc = "${esc}${string.substring(path, k, k + 1)}" }
        k = k + 1
    }
    return "\"${esc}\""
}

profile(writable: ptr) -> string {
    text = "(version 1)(allow default)(deny file-write*)(allow file-write*(regex #\"^/dev/ttys[0-9]+$\")"
    n = list.list_size(writable)
    i = 0
    while i < n {
        path, _e = list.get_string(writable, i)
        text = "${text}(subpath ${sbpl_str_(path)})"
        i = i + 1
    }
    return "${text})"
}

// The SBPL profile of a fence: workspace writes, read-only paths, read rules
// shallow to deep (the last matching rule wins), the network only to the
// proxy, and no handing work to launchd (open) or other apps (Apple events).
// Every denial carries the Spec's deny_tag, when set, as its log message:
// the sandbox's reports in the unified log name the command they belong to.
spec_profile(sp: ptr) -> string {
    s = sp as *Spec
    w = ""
    if s.deny_tag != "" { w = " (with message ${sbpl_str_(s.deny_tag)})" }
    text = "(version 1)(allow default)(deny file-write*${w})(allow file-write*(regex #\"^/dev/ttys[0-9]+$\")"
    i = 0
    while i < list.list_size(s.writes) {
        path, _e0 = list.get_string(s.writes, i)
        text = "${text}(subpath ${sbpl_str_(path)})"
        i = i + 1
    }
    text = "${text})"
    n = list.list_size(s.write_deny)
    i = 0
    while i < n {
        p, _e = list.get_string(s.write_deny, i)
        text = "${text}(deny file-write* (subpath ${sbpl_str_(p)})${w})"
        i = i + 1
    }
    if s.reads != null {
        ordered = rules.sorted(s.reads)
        i = 0
        while i < list.list_size(ordered) {
            r, _e2 = list.get_string(ordered, i)
            if rules.kind_of(r) == rules.DENY {
                text = "${text}(deny file-read-data (subpath ${sbpl_str_(rules.path_of(r))})${w})"
            } else {
                text = "${text}(allow file-read-data (subpath ${sbpl_str_(rules.path_of(r))}))"
            }
            i = i + 1
        }
    }
    if s.net == 1 {
        text = "${text}(deny network*${w})(allow network-outbound (remote ip \"localhost:${s.proxy_port}\"))"
        if s.loopback == 1 {
            text = "${text}(allow network-bind (local ip \"localhost:*\"))(allow network-inbound (local ip \"localhost:*\"))(allow network-outbound (remote ip \"localhost:*\"))"
        }
    }
    return "${text}(deny lsopen${w})(deny appleevent-send${w})"
}

// Landlock read grants for `rules`: Landlock can only add, so a directory
// with a deny below it is granted entry by entry around it (a snapshot:
// entries made in it later stay unreadable). Paths that do not exist are
// skipped.
landlock_reads(rs: ptr) -> ptr {
    out = list.list_new()
    grant_(rs, "/", rules.allows(rs, "/"), out)
    return out
}

// 1 when a rule of `kind` lies strictly below `path`.
below_(rs: ptr, path: string, kind: int) -> int {
    n = list.list_size(rs)
    i = 0
    while i < n {
        r, _e = list.get_string(rs, i)
        p = rules.path_of(r)
        if rules.kind_of(r) == kind && p != path && rules.covers(path, p) == 1 { return 1 }
        i = i + 1
    }
    return 0
}

// An allowed directory is split only around a deny below it; a denied one
// only grants the allows below it.
grant_(rs: ptr, path: string, allowed: int, out: ptr) {
    other = rules.DENY
    if allowed == 0 { other = rules.ALLOW }
    if below_(rs, path, other) == 0 {
        if allowed == 1 && fs.exists(path) == 1 { list.list_add(out, path) }
        return
    }
    if allowed == 0 {
        // Only the rules nearest below a denied directory matter: an allow
        // is granted, a nested deny (a fence $HOME inside the account's
        // home) is entered for the allows below it.
        n = list.list_size(rs)
        i = 0
        while i < n {
            r, _e = list.get_string(rs, i)
            p = rules.path_of(r)
            if p != path && rules.covers(path, p) == 1 && nearest_(rs, path, p) == 1 && (rules.kind_of(r) == rules.ALLOW || rules.allows(rs, p) == 0) {
                grant_(rs, p, rules.allows(rs, p), out)
            }
            i = i + 1
        }
        return
    }
    listing, lerr = dir.list(path)
    if lerr != "" { return }
    c = dir.list_count(listing)
    names = list.list_new()
    j = 0
    while j < c {
        list.list_add(names, string.copy(dir.list_get(listing, j)))
        j = j + 1
    }
    dir.dir_list_free(listing)
    j = 0
    while j < list.list_size(names) {
        name, _e2 = list.get_string(names, j)
        if name != "." && name != ".." {
            child = atomic_file.join(path, name)
            grant_(rs, child, rules.allows(rs, child), out)
        }
        j = j + 1
    }
}

// 1 when no rule lies strictly between `top` and `p`.
nearest_(rs: ptr, top: string, p: string) -> int {
    n = list.list_size(rs)
    i = 0
    while i < n {
        r, _e = list.get_string(rs, i)
        q = rules.path_of(r)
        if q != top && q != p && rules.covers(top, q) == 1 && rules.covers(q, p) == 1 { return 0 }
        i = i + 1
    }
    return 1
}

// "" when the OS sandbox can be applied here, else why not (upstream's
// Unavailable texts). The caller caches it per Tools.
unavailable() -> string {
    if is_mac_() == 1 {
        if fs.exists(SANDBOX_EXEC) == 0 { return "sandbox-exec not found" }
        argv = list.list_new()
        list.list_add(argv, "-p")
        list.list_add(argv, "(version 1)(allow default)")
        list.list_add(argv, "/usr/bin/true")
        _out, code, err = os.run_capture(SANDBOX_EXEC, argv, null)
        if err != "" || code != 0 { return "sandbox-exec cannot apply a profile here" }
        return ""
    }
    if os.platform() == "linux" { return unavailable_text(naebjail_probe()) }
    return "unsupported OS"
}

unavailable_text(code: int) -> string {
    match code {
        0 -> { return "" }
        1 -> { return "kernel has no Landlock" }
        2 -> { return "Landlock is disabled" }
        3 -> { return "Landlock ABI below 2" }
        _ -> { return "unsupported OS" }
    }
}

// Zeroes this process's initial environment area after copying it to the
// heap: a fenced child could otherwise read naeb's environment (secrets
// included) through KERN_PROCARGS2 on macOS. Called once, at start-up.
scrub_environ() -> int { return naebjail_scrub_environ() }

// Marks every descriptor above 2 this process inherited close-on-exec: one
// open on a fenced file would otherwise reach every child, past Landlock
// and SBPL, which check opens. How many it marked.
cloexec_inherited() -> int { return atomic_file.cloexec_inherited() }

// The account's home from the user database ("" unknown): a fence closes it
// as well as $HOME, since a child without $HOME falls back to it.
account_home() -> string { return string.copy(naebjail_account_home()) }

// The proxy URL a child confined by `sp` is told about: the namespace relay
// when it reaches the proxy through a Unix socket (Linux), else the port.
proxy_url(sp: ptr) -> string {
    s = sp as *Spec
    if s.proxy_sock != "" { return "http://127.0.0.1:${RELAY_PORT}" }
    return "http://127.0.0.1:${s.proxy_port}"
}

// "" when a fence's Spec can be applied here, else why not. A fence fails
// closed: the caller refuses the command rather than run it unconfined.
fence_unavailable(sp: ptr) -> string {
    s = sp as *Spec
    if is_mac_() == 1 { return unavailable() }
    if os.platform() != "linux" { return "no project fence on this OS" }
    abi = naebjail_abi()
    if abi == 0 { return "kernel has no Landlock" }
    if abi < 0 { return "Landlock is disabled" }
    if (s.net == 1 || list.list_size(s.write_deny) > 0) && naebjail_probe_userns() == 0 {
        return "unprivileged user namespaces are unavailable"
    }
    return ""
}

add_all_(argv: ptr, items: ptr) {
    i = 0
    while i < list.list_size(items) {
        a, _e = list.get_string(items, i)
        list.list_add(argv, a)
        i = i + 1
    }
}

add_flagged_(argv: ptr, flag: string, items: ptr) {
    i = 0
    while i < list.list_size(items) {
        a, _e = list.get_string(items, i)
        list.list_add(argv, flag)
        list.list_add(argv, a)
        i = i + 1
    }
}

// argv (program first) running `inner` (program first) so that writes
// outside `writable` fail. self_exe is this naeb binary (the Linux helper).
wrap(writable: ptr, inner: ptr, self_exe: string) -> ptr {
    argv = list.list_new()
    if is_mac_() == 1 {
        list.list_add(argv, SANDBOX_EXEC)
        list.list_add(argv, "-p")
        list.list_add(argv, profile(writable))
    } else {
        list.list_add(argv, self_exe)
        list.list_add(argv, HELPER_COMMAND)
        add_flagged_(argv, "-w", writable)
        list.list_add(argv, "--")
    }
    add_all_(argv, inner)
    return argv
}

// wrap for a fence's Spec.
wrap_spec(sp: ptr, inner: ptr, self_exe: string) -> ptr {
    s = sp as *Spec
    argv = list.list_new()
    if is_mac_() == 1 {
        list.list_add(argv, SANDBOX_EXEC)
        list.list_add(argv, "-p")
        list.list_add(argv, spec_profile(sp))
    } else {
        list.list_add(argv, self_exe)
        list.list_add(argv, HELPER_COMMAND)
        add_flagged_(argv, "-w", s.writes)
        add_flagged_(argv, "-W", s.write_deny)
        if s.reads != null {
            list.list_add(argv, "-R")
            add_flagged_(argv, "-r", landlock_reads(s.reads))
        }
        if s.net == 1 {
            list.list_add(argv, "--net")
            list.list_add(argv, s.proxy_sock)
            if s.deny_report != "" {
                list.list_add(argv, "-D")
                list.list_add(argv, s.deny_report)
            }
        }
        list.list_add(argv, "--")
    }
    add_all_(argv, inner)
    return argv
}

fence_error_(code: int) -> string {
    match code {
        -1 -> { return "LandlockUnavailable" }
        -2 -> { return "NamespaceUnavailable" }
        -3 -> { return "MountFailed" }
        -4 -> { return "LoopbackFailed" }
        -5 -> { return "RelayFailed" }
        -6 -> { return "SeccompFailed" }
        _ -> { return "FenceFailed" }
    }
}

// `naeb __jail [-w root]... [-W path]... [-R [-r path]...] [--net sock [-D report]] --
// <command>...` (args after __jail): restrict this process, then become the
// command. Returns only on failure, with the reason.
helper(args: ptr) -> string {
    if os.platform() != "linux" { return "UnsupportedOs" }
    n = list.list_size(args)
    writes = ""
    wdeny = ""
    reads = ""
    reads_on = 0
    sock = ""
    report = ""
    fenced = 0
    split = -1
    i = 0
    while i < n {
        a, _e = list.get_string(args, i)
        if a == "--" {
            split = i
            break
        }
        if a == "-R" {
            reads_on = 1
            fenced = 1
            i = i + 1
            continue
        }
        if i + 1 >= n { return "InvalidArguments" }
        v, _e2 = list.get_string(args, i + 1)
        if a == "-w" {
            writes = "${writes}${v}\n"
        } else if a == "-W" {
            wdeny = "${wdeny}${v}\n"
            fenced = 1
        } else if a == "-r" {
            reads = "${reads}${v}\n"
        } else if a == "--net" {
            sock = v
            fenced = 1
        } else if a == "-D" {
            report = v
        } else {
            return "InvalidArguments"
        }
        i = i + 2
    }
    if split < 0 || split + 1 >= n { return "InvalidArguments" }
    if fenced == 0 {
        if naebjail_restrict(writes) != 0 { return "LandlockUnavailable" }
    } else {
        rc = naebjail_fence(writes, wdeny, reads, reads_on, sock, report)
        if rc != 0 { return fence_error_(rc) }
    }
    command = list.list_new()
    i = split + 1
    while i < n {
        c, _e3 = list.get_string(args, i)
        list.list_add(command, c)
        i = i + 1
    }
    prog, _e4 = list.get_string(command, 0)
    os.os_execv(prog, command)
    return "exec failed"
}

// "macos", "linux", or the platform's own name.
os_name() -> string {
    if is_mac_() == 1 { return "macos" }
    return os.platform()
}

is_mac_() -> int {
    p = os.platform()
    if p == "darwin" || p == "macos" { return 1 }
    return 0
}
