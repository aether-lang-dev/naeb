// tui.bill: the quiet footer and the status details of a turn's usage
// (upstream src/tui/bill.zig).
// Differences from upstream: no Text buffer struct, so format/details/fit are
// plain functions returning new strings (no 1024-byte truncation); the
// TurnSummary is naeb.tui.turn_summary's; runs/width are int.

import std.string
import term.screen
import naeb.tui.format
import naeb.tui.turn_summary

exports(format_footer, details, fit)

plural_(n: long) -> string {
    if n == 1 { return "" }
    return "s"
}

// The quiet footer: only the elapsed time (upstream's Text.format; `format`
// is also the name of the imported module). Empty when it cannot fit.
format_footer(summary: turn_summary.TurnSummary, width: int) -> string {
    if summary.timing.wall_ms == 0 { return "" }
    return fit(format.duration(summary.timing.wall_ms), width)
}

// The statistics `/status` shows for the last Turn, which the footer leaves out.
details(summary: turn_summary.TurnSummary, runs: int) -> string {
    denom = summary.usage.prompt_tokens
    if denom < 1 { denom = 1 }
    pct = summary.usage.prompt_cache_hit_tokens * 100 / denom
    return "Last turn · ${summary.status}\n${runs} Run${plural_(runs as long)} · ${summary.steps} step${plural_(summary.steps)}\nTotal ${format.duration(summary.timing.wall_ms)} · model ${format.duration(summary.timing.model_ms)} · Run ${format.duration(summary.timing.run_ms)}\nInput ${summary.usage.prompt_tokens} tokens · output ${summary.usage.completion_tokens} tokens\nCache ${summary.usage.prompt_cache_hit_tokens} tokens · ${pct}% of input · writes ${summary.usage.prompt_cache_write_tokens} tokens\nTool data ${format.bytes(summary.timing.tool_bytes)} → ${format.bytes(summary.timing.output_bytes)}\nDelegation · llm ${summary.timing.llm_calls} · agent ${summary.timing.agent_calls}"
}

// Code points in `s` (UTF-8 lead bytes).
codepoints_(s: string) -> int {
    n = 0
    i = 0
    len = string.length(s)
    while i < len {
        if (s[i] & 192) != 128 { n = n + 1 }
        i = i + 1
    }
    return n
}

// Byte offset of the last " · " in `s`, -1 if none.
last_separator_(s: string) -> int {
    sep = " · "
    seplen = string.length(sep)
    i = string.length(s) - seplen
    while i >= 0 {
        if string.substring(s, i, i + seplen) == sep { return i }
        i = i - 1
    }
    return -1
}

// Drops whole trailing " · " fields until the line fits `width` code points; "" if none fits.
fit(full: string, width: int) -> string {
    line = full
    while codepoints_(line) > width {
        end = last_separator_(line)
        if end < 0 { return "" }
        line = string.substring(line, 0, end)
    }
    return line
}
