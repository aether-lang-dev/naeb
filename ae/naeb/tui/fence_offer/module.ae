// tui.fence_offer: naeb's approval prompt (docs/naeb/adr/0001). The app
// collects the refusal records with a suggestion from Run results and
// background results; when no Turn runs and the input is empty it asks the
// port for a proposal (fence_propose), shows it and waits for y/N. Only y
// or Y applies; any other key declines, except the keys that scroll. What
// was offered once (by op and resource) is not offered again in the
// Session, whatever the answer.
//
// The Maven broker's too-young refusals (op "maven_age", no suggestion)
// are offered too, one coordinate per prompt, after any naeb.ae change:
// y fetches exactly the versions the refusal named (maven_override).
//
// A record with a note and no suggestion (a path naeb never opens by a
// prompt) is shown as a dim line saying why, with nothing to answer.
// A fenced command that found no Java gets a dim hint once per Session.

import std.list
import std.string
import std.json
import naeb.jsonx

exports(Offer, new, collect, collect_result, pending, take, reset, answer_of, text_of, notes_text, applied_text,
        has_policy, take_young, young_text, fetched_text, java_missing, java_hint, JAVA_HINT, KIND_POLICY, KIND_MAVEN,
        ANSWER_NONE, ANSWER_YES, ANSWER_NO)

// A failed build's compiler output shows its first lines only.
const OUTPUT_LINES = 12

const ANSWER_NONE = 0
const ANSWER_YES = 1
const ANSWER_NO = 2

// What the open prompt asks.
const KIND_POLICY = 0
const KIND_MAVEN = 1

// What a fenced command prints when it finds no Java (the macOS stub, mvnw,
// a shell).
const JAVA_MISSING[] = ["Unable to locate a Java Runtime", "JAVA_HOME is not defined correctly",
                        "JAVA_HOME environment variable is not defined correctly", "java: command not found",
                        "java/javac command does not exist in PATH nor is JAVA_HOME set"]
const JAVA_MISSING_COUNT = 5

const JAVA_HINT = "No Java inside the fence: start naeb with JAVA_HOME set to a JDK (naeb passes JAVA_HOME into the fence; a JDK under $HOME also needs policy.allow_read)"

struct Offer {
    records: ptr      // JSON texts of collected records not yet offered
    keys: ptr         // "op resource" of every record collected or offered this Session
    session: string   // the Session `keys` belong to
    open: int         // 1: a prompt waits for its answer
    building: int     // 1: approved, the policy is being rebuilt
    proposal: string  // the open prompt's proposal JSON
    entry: int        // the open prompt's transcript entry, -1 none
    young: ptr        // JSON texts of the broker's too-young refusals not yet offered
    kind: int         // KIND_*: what the open prompt (or the build/fetch after it) is
    java_hinted: int  // 1: the no-Java hint was shown this Session
}

new() -> *Offer {
    o = heap.new(Offer)
    o.records = list.list_new()
    o.keys = list.list_new()
    o.session = ""
    o.open = 0
    o.building = 0
    o.proposal = ""
    o.entry = -1
    o.young = list.list_new()
    o.kind = KIND_POLICY
    o.java_hinted = 0
    return o
}

has_(l: ptr, s: string) -> int {
    i = 0
    while i < list.list_size(l) {
        v, _g = list.get_string(l, i)
        if v == s { return 1 }
        i = i + 1
    }
    return 0
}

// A new Session forgets what the old one offered.
reset(o: *Offer, session: string) {
    if o.session == session { return }
    o.session = string.copy(session)
    o.records = list.list_new()
    o.keys = list.list_new()
    o.young = list.list_new()
    o.java_hinted = 0
}

// Adds the records of a fence_denied array (a parsed JSON value) that carry
// a suggestion or a note and were not collected or offered before.
collect(o: *Offer, denied: ptr) {
    if denied == null || json.json_type(denied) != json.JSON_ARRAY { return }
    i = 0
    while i < jsonx.array_size(denied) {
        r = jsonx.array_at(denied, i)
        if jsonx.str_or(r, "op", "") == "maven_age" {
            ykey = "maven_age ${jsonx.str_or(r, "resource", "")}"
            if has_(o.keys, ykey) == 0 {
                list.list_add(o.keys, string.copy(ykey))
                list.list_add(o.young, string.copy(jsonx.encode(r)))
            }
        } else if jsonx.str_or(r, "suggestion", "") != "" || jsonx.str_or(r, "note", "") != "" {
            key = "${jsonx.str_or(r, "op", "")} ${jsonx.str_or(r, "resource", "")}"
            if has_(o.keys, key) == 0 {
                list.list_add(o.keys, string.copy(key))
                list.list_add(o.records, string.copy(jsonx.encode(r)))
            }
        }
        i = i + 1
    }
}

// collect for a result text that is a JSON object (a background bash
// result) with a fence_denied member; anything else is ignored.
collect_result(o: *Offer, text: string) {
    if string.starts_with(text, "{") == 0 { return }
    v = jsonx.parse(text)
    if v == null { return }
    collect(o, jsonx.field(v, "fence_denied"))
    jsonx.free(v)
}

pending(o: *Offer) -> bool { return (list.list_size(o.records) > 0 || list.list_size(o.young) > 0) && o.open == 0 && o.building == 0 }

// Whether naeb.ae lines wait to be offered (they go before Maven's).
has_policy(o: *Offer) -> bool { return list.list_size(o.records) > 0 }

// The next too-young refusal to offer (its JSON), removed; "" none.
take_young(o: *Offer) -> string {
    if list.list_size(o.young) == 0 { return "" }
    r, _g = list.get_string(o.young, 0)
    out = string.copy(r)
    list.list_remove(o.young, 0)
    return out
}

// The prompt for a too-young refusal: what would be fetched and how old.
young_text(record: string) -> string {
    v = jsonx.parse(record)
    if v == null { return "" }
    out = "Maven broker refused ${jsonx.str_or(v, "resource", "")}: naeb.ae asks for versions published ${jsonx.int_or(v, "min_age_days", 0)} days ago or more\n"
    y = jsonx.field(v, "young")
    i = 0
    while i < jsonx.array_size(y) {
        it = jsonx.array_at(y, i)
        age = jsonx.int_or(it, "age_days", -1)
        said = if age < 0 { "the newest in the range" } else if age == 1 { "published 1 day ago" } else { "published ${age} days ago" }
        out = "${out}    ${jsonx.str_or(it, "gav", "")} · ${said}\n"
        i = i + 1
    }
    jsonx.free(v)
    return "${out}Fetch it anyway (this time, these versions only)? [y/N]"
}

// The transcript line after maven_fetched (tools.maven_fetch's result).
fetched_text(result: string) -> (string, bool) {
    v = jsonx.parse(result)
    if v == null { return "Maven broker: no result", false }
    if jsonx.has(v, "error") == 1 {
        e = string.copy(jsonx.str_or(v, "error", ""))
        jsonx.free(v)
        return "Maven broker: nothing fetched · ${e}", false
    }
    out = ""
    f = jsonx.field(v, "fetched")
    i = 0
    while i < jsonx.array_size(f) {
        it = jsonx.array_at(f, i)
        if i > 0 { out = "${out}, " }
        out = "${out}${jsonx.str_or(it, "gav", "")}"
        i = i + 1
    }
    ok = jsonx.bool_or(v, "ok", 0) == 1
    text = if out == "" { "Maven broker: nothing new fetched" } else { "Maven broker fetched ${out} · approved by you" }
    r = jsonx.field(v, "refused")
    k = 0
    while k < jsonx.array_size(r) {
        it2 = jsonx.array_at(r, k)
        text = "${text}\nrefused ${jsonx.str_or(it2, "gav", "")} · ${jsonx.str_or(it2, "reason", "")}"
        k = k + 1
    }
    jsonx.free(v)
    return text, ok
}

// The collected records as one JSON array, emptied.
take(o: *Offer) -> string {
    out = "["
    i = 0
    while i < list.list_size(o.records) {
        r, _g = list.get_string(o.records, i)
        if i > 0 { out = "${out}," }
        out = "${out}${r}"
        i = i + 1
    }
    o.records = list.list_new()
    return "${out}]"
}

// What a key answers an open prompt: y or Y applies; a key that scrolls
// (scrolls: true) answers nothing; anything else declines.
answer_of(text: string, scrolls: bool) -> int {
    if scrolls { return ANSWER_NONE }
    if text == "y" || text == "Y" { return ANSWER_YES }
    return ANSWER_NO
}

// The refusals a proposal (naeb.fence.policy.propose's JSON) offers no line
// for, one per line with why; "" none.
notes_text(proposal: string) -> string {
    v = jsonx.parse(proposal)
    if v == null { return "" }
    notes = jsonx.field(v, "notes")
    out = ""
    i = 0
    while i < jsonx.array_size(notes) {
        if i > 0 { out = "${out}\n" }
        out = "${out}${jsonx.str_or(jsonx.array_at(notes, i), "summary", "")}"
        i = i + 1
    }
    jsonx.free(v)
    return out
}

// Whether a fenced command's output says it found no Java.
java_missing(text: string) -> bool {
    k = 0
    while k < JAVA_MISSING_COUNT {
        if string.contains(text, JAVA_MISSING[k]) == 1 { return true }
        k = k + 1
    }
    return false
}

// The no-Java hint for `text` (a Run's or background command's output),
// once per Session: JAVA_HINT, or "".
java_hint(o: *Offer, text: string) -> string {
    if o.java_hinted != 0 || !java_missing(text) { return "" }
    o.java_hinted = 1
    return JAVA_HINT
}

// The prompt for a proposal (naeb.fence.policy.propose's JSON): one line per
// proposed line saying what it answers, then the diff and the question; or,
// when naeb cannot place the lines, the lines to add by hand. Notes are
// notes_text's, not part of it.
text_of(proposal: string) -> string {
    v = jsonx.parse(proposal)
    if v == null { return "" }
    items = jsonx.field(v, "items")
    out = ""
    i = 0
    while i < jsonx.array_size(items) {
        out = "${out}${jsonx.str_or(jsonx.array_at(items, i), "summary", "")}\n"
        i = i + 1
    }
    if jsonx.has(v, "diff") == 1 {
        out = "${out}${jsonx.str_or(v, "diff", "")}Allow? [y/N]"
    } else {
        out = "${out}naeb.ae unchanged: ${jsonx.str_or(v, "error", "")}\nAdd to fence(p: ptr) by hand, then run: naeb build\n"
        k = 0
        while k < jsonx.array_size(items) {
            out = "${out}    ${jsonx.str_or(jsonx.array_at(items, k), "line", "")}\n"
            k = k + 1
        }
        out = string.substring(out, 0, string.length(out) - 1)
    }
    jsonx.free(v)
    return out
}

// The transcript line after fence_applied (its JSON object as text).
applied_text(result: string) -> (string, bool) {
    v = jsonx.parse(result)
    ok = jsonx.bool_or(v, "ok", 0) == 1
    text = ""
    if ok {
        text = "naeb.ae changed · policy rebuilt and loaded"
    } else {
        e = jsonx.str_or(v, "error", "")
        o = string.trim(jsonx.str_or(v, "output", ""))
        text = "naeb.ae not changed · ${e}"
        if o != "" { text = "${text}\n${preview_(o, OUTPUT_LINES)}" }
    }
    jsonx.free(v)
    return text, ok
}

// The first `n` lines of `text`, then "… N more lines" for the rest.
preview_(text: string, n: int) -> string {
    lines = string.split(text, "\n")
    total = string.array_size(lines)
    if total <= n {
        string.array_free(lines)
        return text
    }
    out = ""
    i = 0
    while i < n {
        if i > 0 { out = "${out}\n" }
        out = "${out}${string.array_get(lines, i)}"
        i = i + 1
    }
    string.array_free(lines)
    more = total - n
    plural = if more == 1 { "line" } else { "lines" }
    return "${out}\n… ${more} more ${plural} of the compiler's output"
}
