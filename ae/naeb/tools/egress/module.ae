// tools.egress: naeb's egress proxy for a project fence (docs/naeb/adr/0001).
// The only way out for a fenced child and for tools.fetch: `CONNECT
// host:port` (TLS is tunnelled, never intercepted) and absolute-form
// `GET http://host/...`, allowed only for the fence's host:port pairs; any
// other is answered 403 with the pair named. Names are resolved here:
// children have no DNS. The proxy connects to an address it vetted, never
// re-resolving: a loopback, private, link-local, unspecified, multicast or
// reserved address (IPv4-mapped and NAT64 forms by the address they carry)
// only when the fence names that very address for the port, so an allowed
// name that resolves (or rebinds) to a local service is refused.
//
// A Proxy holds the fence; every user opens its own Channel: a listener of
// its own (127.0.0.1 for tools.fetch and macOS children, a Unix socket under
// the run directory for the namespace relay of tools/jail on Linux) whose
// refusals are recorded for that channel only, so a refusal is reported with
// the command whose process made the connection. Nothing here is module state.

import std.tcp
import std.fs
import std.list
import std.string
import std.sync
import std.worker
import nib.lock
import nib.fence

@source("resolve.c")

exports(Proxy, Channel, new, channel, child_channel, channel_url, channel_port, channel_sock, channel_close, channel_take, parse_target,
        vet, addresses_for)

extern nibnet_resolve(host: string) -> string @heap
extern nibnet_vet(addr: string) -> string

const HEADER_LIMIT = 16384
const IDLE_MS = 300000

struct Proxy {
    fence: ptr
    sock_prefix: string // Unix channels' socket paths start with it
    seq: ptr           // std.sync cell: numbers Unix channels
}

// One way in. Shared by its owner, its accept thread and the connections in
// flight; refs counts them and the last release frees it.
struct Channel {
    proxy: ptr
    server: ptr        // the listener: closed by the accept thread when it stops
    port: int          // 0 for a Unix channel
    sock: string       // the Unix socket's path, or ""
    guard: ptr
    denied: ptr        // "host:port" refused here; null once the owner took it
    stopped: ptr       // std.sync cell
    refs: ptr          // std.sync cell
}

// A proxy for `fence_p`. sock_prefix: a path the Unix channels' sockets are
// named after ("<prefix>-<n>.sock"; its directory is made on first use), or
// "" when none will be opened.
new(fence_p: @keep ptr, sock_prefix: string) -> ptr {
    p = heap.new(Proxy)
    p.fence = fence_p
    p.sock_prefix = sock_prefix
    p.seq = sync.atomic_new(0)
    return p as ptr
}

// A new way in: (channel, "") or (null, why). use_unix: 1 for a Unix socket in
// the proxy's socket directory, 0 for 127.0.0.1 on a free port.
channel(pp: @keep ptr, use_unix: int) -> (ptr, string) {
    p = pp as *Proxy
    server = null
    port = 0
    sock = ""
    if use_unix == 1 {
        if p.sock_prefix == "" { return null, "egress proxy: no socket path for a Unix channel" }
        fs.mkdir_p(fs.path_dirname(p.sock_prefix))
        n = sync.atomic_add(p.seq, 1 as long)
        sock = "${p.sock_prefix}-${n}.sock"
        if fs.exists(sock) == 1 { fs.delete(sock) }
        us, uerr = tcp.listen_unix(sock)
        if uerr != "" { return null, "egress proxy: ${uerr}" }
        server = us
    } else {
        ts, terr = tcp.listen_on("127.0.0.1", 0)
        if terr != "" { return null, "egress proxy: ${terr}" }
        server = ts
        port = tcp.server_port(ts)
    }
    c = heap.new(Channel)
    c.proxy = pp
    c.server = server
    c.port = port
    c.sock = sock
    c.guard = lock.new()
    c.denied = list.list_new()
    c.stopped = sync.atomic_new(0)
    c.refs = sync.atomic_new(2)    // the owner and the accept thread
    cp = c as ptr
    worker.run_detached(|| {
        accept_loop_(cp)
        return null
    })
    return cp, ""
}

// A channel for a fenced child: a Unix socket when the proxy has a socket
// path (Linux: the namespace relay reaches it), else 127.0.0.1.
child_channel(pp: @keep ptr) -> (ptr, string) {
    use_unix = 0
    if (pp as *Proxy).sock_prefix != "" { use_unix = 1 }
    return channel(pp, use_unix)
}

// The URL tools.fetch uses for a 127.0.0.1 channel.
channel_url(cp: ptr) -> string { return "http://127.0.0.1:${(cp as *Channel).port}" }
channel_port(cp: ptr) -> int { return (cp as *Channel).port }
channel_sock(cp: ptr) -> string { return (cp as *Channel).sock }

// Stops the channel (its listener closes within the accept poll) and hands
// back the pairs it refused ("host:port", or "host:port <reason>" when the
// pair is allowed but where it resolves is not), oldest first. The channel must not be used
// after; a connection still in flight finishes without recording.
channel_close(cp: ptr) -> ptr {
    c = cp as *Channel
    sync.atomic_store(c.stopped, 1)
    lock.acquire(c.guard)
    out = c.denied
    c.denied = null
    lock.release(c.guard)
    release_(c)
    return out
}

// The pairs refused since the last take, oldest first; the channel stays open.
channel_take(cp: ptr) -> ptr {
    c = cp as *Channel
    out = list.list_new()
    lock.acquire(c.guard)
    if c.denied != null {
        out = c.denied
        c.denied = list.list_new()
    }
    lock.release(c.guard)
    return out
}

release_(c: *Channel) {
    if sync.atomic_sub(c.refs, 1 as long) != 0 { return }
    lock.free(c.guard)
    sync.atomic_free(c.stopped)
    sync.atomic_free(c.refs)
    heap.free(c)
}

accept_loop_(cp: @keep ptr) {
    c = cp as *Channel
    while sync.atomic_load(c.stopped) == 0 {
        if tcp.server_poll(c.server, 200) <= 0 { continue }
        conn, err = tcp.accept(c.server)
        if err != "" { continue }
        sync.atomic_add(c.refs, 1 as long)
        worker.run_detached(|| {
            handle_(cp, conn)
            release_(cp as *Channel)
            return null
        })
    }
    tcp.tcp_server_close(c.server)
    release_(c)
}

deny_(c: *Channel, pair: string) {
    lock.acquire(c.guard)
    if c.denied != null { list.list_add(c.denied, pair) }
    lock.release(c.guard)
}

send_text_(sock: ptr, text: string) {
    tcp.write_all(sock, string.bytes(text)[0..string.length(text)])
}

// host, port and the rest of an authority ("h:1", "[::1]:2", "h" with dflt).
parse_target(authority: string, dflt: int) -> (string, int) {
    a = authority
    if string.starts_with(a, "[") == 1 {
        close_b = string.index_of(a, "]")
        if close_b < 0 { return "", 0 }
        host = string.substring(a, 1, close_b)
        rest = string.substring(a, close_b + 1, string.length(a))
        if string.starts_with(rest, ":") == 1 { return host, port_of_(string.substring(rest, 1, string.length(rest))) }
        return host, dflt
    }
    colon = string.index_of(a, ":")
    if colon < 0 { return a, dflt }
    return string.substring(a, 0, colon), port_of_(string.substring(a, colon + 1, string.length(a)))
}

// A decimal port, or 0.
port_of_(s: string) -> int {
    n = string.length(s)
    if n == 0 || n > 5 { return 0 }
    v = 0
    i = 0
    while i < n {
        c = string.char_at(s, i)
        if c < 48 || c > 57 { return 0 }
        v = v * 10 + (c - 48)
        i = i + 1
    }
    if v > 65535 { return 0 }
    return v
}

handle_(chp: @keep ptr, c: @keep ptr) {
    ch = chp as *Channel
    p = ch.proxy as *Proxy
    head = ""
    end = -1
    while end < 0 && string.length(head) < HEADER_LIMIT {
        ready, _perr = tcp.poll(c, 10000)
        if !ready {
            tcp.tcp_close(c)
            return
        }
        chunk, n, rerr = tcp.read_n(c, 8192)
        if rerr == "timeout" { continue }
        if rerr != "" || n <= 0 {
            tcp.tcp_close(c)
            return
        }
        head = "${head}${chunk}"
        end = string.index_of(head, "\r\n\r\n")
    }
    if end < 0 {
        send_text_(c, "HTTP/1.1 431 Request Header Fields Too Large\r\nConnection: close\r\n\r\n")
        tcp.tcp_close(c)
        return
    }
    line_end = string.index_of(head, "\r\n")
    line = string.substring(head, 0, line_end)
    sp1 = string.index_of(line, " ")
    sp2 = -1
    if sp1 > 0 { sp2 = string.index_of_from(line, " ", sp1 + 1) }
    if sp1 <= 0 || sp2 <= sp1 {
        send_text_(c, "HTTP/1.1 400 Bad Request\r\nConnection: close\r\n\r\n")
        tcp.tcp_close(c)
        return
    }
    method = string.substring(line, 0, sp1)
    target = string.substring(line, sp1 + 1, sp2)
    version = string.substring(line, sp2 + 1, string.length(line))
    rest = string.substring(head, end + 4, string.length(head))
    host = ""
    port = 0
    forward = ""
    if method == "CONNECT" {
        host, port = parse_target(target, 443)
    } else if string.starts_with(string.to_lower(target), "http://") == 1 {
        after = string.substring(target, 7, string.length(target))
        slash = string.index_of(after, "/")
        authority = after
        path = "/"
        if slash >= 0 {
            authority = string.substring(after, 0, slash)
            path = string.substring(after, slash, string.length(after))
        }
        host, port = parse_target(authority, 80)
        forward = "${method} ${path} ${version}${string.substring(head, line_end, end + 4)}"
    } else {
        send_text_(c, "HTTP/1.1 400 Bad Request\r\nConnection: close\r\n\r\nnaeb: only CONNECT and absolute http:// requests go through this proxy\n")
        tcp.tcp_close(c)
        return
    }
    pair = "${host}:${port}"
    if host == "" || port <= 0 || fence.host_allowed(p.fence, host, port) == 0 {
        deny_(ch, pair)
        body = "naeb: egress to ${pair} is not in the project fence\n"
        send_text_(c, "HTTP/1.1 403 Forbidden\r\nContent-Type: text/plain\r\nContent-Length: ${string.length(body)}\r\nConnection: close\r\nX-Naeb-Denied: ${pair}\r\n\r\n${body}")
        tcp.tcp_close(c)
        return
    }
    addrs, why = addresses_for(p.fence, host, port)
    if why != "" {
        deny_(ch, "${pair} ${why}")
        body = "naeb: egress to ${pair} refused: ${why}; the project fence reaches such an address only where naeb.ae names it\n"
        send_text_(c, "HTTP/1.1 403 Forbidden\r\nContent-Type: text/plain\r\nContent-Length: ${string.length(body)}\r\nConnection: close\r\nX-Naeb-Denied: ${pair}\r\n\r\n${body}")
        tcp.tcp_close(c)
        return
    }
    up = null
    uerr = "does not resolve"
    k = 0
    while k < list.list_size(addrs) && up == null {
        a, _ae = list.get_string(addrs, k)
        u, e = tcp.connect_timeout(a, port, 10000)
        if e == "" { up = u } else { uerr = e }
        k = k + 1
    }
    list.list_free(addrs)
    if up == null {
        send_text_(c, "HTTP/1.1 502 Bad Gateway\r\nConnection: close\r\n\r\nnaeb: ${pair}: ${uerr}\n")
        tcp.tcp_close(c)
        return
    }
    if method == "CONNECT" {
        send_text_(c, "HTTP/1.1 200 Connection established\r\n\r\n")
    } else {
        send_text_(up, forward)
    }
    if string.length(rest) > 0 { tcp.write_all(up, string.bytes(rest)[0..string.length(rest)]) }
    splice_(c, up)
    tcp.tcp_close(up)
    tcp.tcp_close(c)
}

// Why the proxy does not connect to the numeric `addr` on its own: a
// loopback, private, ... address (see the top), or "" for a public one.
vet(addr: string) -> string { return string.copy(nibnet_vet(addr)) }

// The addresses to try, in order, for an allowed `host`:`port`: (list,
// "") of those vetted (public, or named for the port by the fence), (empty,
// "resolves to <address>, a <kind> address") when it resolves only to
// refused ones, (empty, "") when it does not resolve.
addresses_for(fp: ptr, host: string, port: int) -> (ptr, string) {
    h = host
    if string.starts_with(h, "[") == 1 && string.ends_with(h, "]") == 1 { h = string.substring(h, 1, string.length(h) - 1) }
    text = nibnet_resolve(h)
    out = list.list_new()
    first_why = ""
    n = string.length(text)
    i = 0
    while i < n {
        j = string.index_of_from(text, "\n", i)
        if j < 0 { j = n }
        a = string.substring(text, i, j)
        i = j + 1
        if a == "" { continue }
        why = vet(a)
        if why == "" || fence.host_named(fp, a, port) == 1 { list.list_add(out, a) } else if first_why == "" {
            first_why = "resolves to ${a}, a ${why} address"
        }
    }
    if list.list_size(out) > 0 { return out, "" }
    return out, first_why
}

// Copies bytes both ways until either side closes or both idle IDLE_MS.
splice_(a: ptr, b: ptr) {
    idle = 0
    while idle < IDLE_MS {
        r = tcp.tcp_poll2_raw(a, b, 1000)
        if r < 0 { return }
        if r == 0 {
            idle = idle + 1000
            continue
        }
        idle = 0
        if (r & 1) != 0 {
            if relay_(a, b) == 0 { return }
        }
        if (r & 2) != 0 {
            if relay_(b, a) == 0 { return }
        }
    }
}

relay_(from: ptr, to: ptr) -> int {
    data, n, err = tcp.read_n(from, 65536)
    if err == "timeout" { return 1 }
    if err != "" || n <= 0 { return 0 }
    _w, werr = tcp.write_all(to, string.bytes(data)[0..n])
    if werr != "" { return 0 }
    return 1
}
